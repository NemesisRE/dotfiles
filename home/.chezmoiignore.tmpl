{{- $syncTerminalSettings := false -}}
{{- if and (hasKey . "windows") (hasKey .windows "microsoftTerminal") (hasKey .windows.microsoftTerminal "sync_settings") -}}
{{-   $syncTerminalSettings = .windows.microsoftTerminal.sync_settings -}}
{{- end -}}

{{- $syncWslConfig := false -}}
{{- if and (hasKey . "windows") (hasKey .windows "wsl") (hasKey .windows.wsl "sync_config") -}}
{{-   $syncWslConfig = .windows.wsl.sync_config -}}
{{- end -}}

{{- $syncWingetSettings := false -}}
{{- if and (hasKey . "windows") (hasKey .windows "winget") (hasKey .windows.winget "sync_settings") -}}
{{-   $syncWingetSettings = .windows.winget.sync_settings -}}
{{- end -}}

{{- if ne .chezmoi.os "windows" }}
AppData
Documents/WindowsPowerShell
Documents/WindowsTerminal
.wslconfig
.chezmoiscripts/*.ps1
.local/bin/*.cmd
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
Library
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/systemd
# VS Code only reads ~/.config/Code on Linux (macOS: ~/Library/Application Support,
# Windows: %APPDATA%). Elsewhere it is a never-read extra copy of the MCP secrets.
.config/Code
# Konsole is KDE's terminal emulator; it has no macOS or Windows build.
.local/share/konsole
{{- end }}

{{- /*
Nu's OS-native config dir differs per OS (~/Library/Application Support/nushell
on macOS, %APPDATA%\nushell on Windows), but nu prioritizes $XDG_CONFIG_HOME/nushell
over that native path the instant XDG_CONFIG_HOME is set in the environment —
confirmed live: launching nu from a shell this framework already configured (every
other shell here exports XDG_CONFIG_HOME) makes nu read ~/.config/nushell instead of
the OS-native stub, bootstrapping its own vanilla default config there if nothing of
ours exists at that path. So ~/.config/nushell/{env,config}.nu is deployed
unconditionally on every OS — not gated to Linux — as a second copy of the same thin
stub, to cover whichever path nu actually picks. See docs/shells.md.
*/ -}}

{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") (hasKey .chezmoi.kernel "osrelease") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
.chezmoiscripts/*kitty.sh
{{- end }}

{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/*.sh
.hushlogin
.config/powershell
# fish has no Windows build at all (not even via WSL-less native Windows), so
# unlike PowerShell's cross-platform tree, deploying its config there is pure
# dead weight with no runtime-branch payoff.
.config/fish
# zsh itself (and the zsh-only tools around it: sheldon is a zsh plugin
# manager, .blerc configures ble.sh, a bash line editor irrelevant without a
# POSIX interactive shell) has no Windows build.
.config/zsh
.zshrc
.zshenv
.zprofile
.blerc
.config/sheldon
# kitty and drydock (its quake-mode/session-launch tooling) have no Windows
# build.
.config/kitty
.config/drydock
# Windows has its own daily-sync entry point (NREDF_DailySync.ps1); the POSIX
# script is dead weight there.
.local/bin/nredf-daily-sync
{{-   if not $syncTerminalSettings }}
AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe
{{-   end }}
{{-   if not $syncWingetSettings }}
AppData/Local/Packages/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe
{{-   end }}
{{-   if not $syncWslConfig }}
.wslconfig
{{-   end }}
{{- end }}
