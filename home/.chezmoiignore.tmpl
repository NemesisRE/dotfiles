{{- if ne .chezmoi.os "linux" }}
.config/systemd
# VS Code only reads ~/.config/Code on Linux (macOS: ~/Library/Application Support,
# Windows: %APPDATA%). Elsewhere it is a never-read extra copy of the MCP secrets.
.config/Code
{{- end }}

{{- /*
Nu's OS-native config dir differs per OS (~/Library/Application Support/nushell
on macOS, %APPDATA%\nushell on Windows), but nu prioritizes $XDG_CONFIG_HOME/nushell
over that native path the instant XDG_CONFIG_HOME is set in the environment —
confirmed live: launching nu from a shell this framework already configured (every
other shell here exports XDG_CONFIG_HOME) makes nu read ~/.config/nushell instead of
the OS-native stub, bootstrapping its own vanilla default config there if nothing of
ours exists at that path. So ~/.config/nushell/{env,config}.nu is deployed
unconditionally on every OS — not gated to Linux — as a second copy of the same thin
stub, to cover whichever path nu actually picks. See docs/shells.md.
*/ -}}

{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") (hasKey .chezmoi.kernel "osrelease") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
.chezmoiscripts/*kitty.sh
{{- end }}

{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/*.sh
.Xresources
.minttyrc
.hushlogin
.config/terminator
.config/tilda
.config/screen
.config/powershell
# fish has no Windows build at all (not even via WSL-less native Windows), so
# unlike PowerShell's cross-platform tree, deploying its config there is pure
# dead weight with no runtime-branch payoff.
.config/fish
