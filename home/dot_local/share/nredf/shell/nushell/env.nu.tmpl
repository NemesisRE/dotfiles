{{- /* WSL is a fact about the machine, so decide it once at apply time (the same test .chezmoiignore.tmpl uses) instead of probing /proc/version in every shell. */ -}}
{{- $isWSL := and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") (hasKey .chezmoi.kernel "osrelease") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
# chezmoi-managed nu env.nu — env-only half of the nu entry point. Sourced by
# one of the thin per-OS stubs (~/.config/nushell, ~/Library/Application
# Support/nushell, or ~/AppData/Roaming/nushell — see AGENTS.md).
#
# nu's own convention is: env.nu sets environment variables only (must never
# prompt or print — this runs for `nu -l` too, not just real interactive
# sessions), config.nu (the sibling file) holds interactive-only setup
# (aliases, prompts, keybindings). This mirrors bash's split between
# common/rc.tmpl's early, always-safe section and its later interactive-only
# one, collapsed to nu's own two-file model instead of a "common" tier — nu
# has no sibling shell to share a literal file with, so unlike bash/zsh this
# is nu's own from-scratch equivalent, not a shared file.

$env.NREDF_SHELL_NAME = "nu"
if ($env.NREDF_DOT_PATH? | default "" | is-empty) {
    $env.NREDF_DOT_PATH = ($env.XDG_DATA_HOME? | default ($env.HOME | path join ".local" "share") | path join "nredf")
}

# Standard 24h throttle interval for all daily operations (matches
# common/rc.tmpl's NREDF_24H_INTERVAL for bash/zsh). Used by
# nredf-cache-refresh's --next argument, which nredf-cache-refresh's own
# try/catch was silently swallowing every failure of until this was added —
# see docs/shells.md.
$env.NREDF_24H_INTERVAL = 86400

# Load all nu function definitions. Unlike bash/zsh/fish, nu cannot fall
# back to globbing the functions/ directory when the bundle is absent: that
# fallback would need to `source` a runtime-determined file list, and nu's
# `source`/`source-env` require a literal, parse-time-constant path to a
# file that already exists — the same restriction that rules out a generic
# cached-snippet loader (see docs/shells.md's parity-exceptions section). So
# for nu the generated bundle is not just a fast path, it is the only path:
# the literal location below is baked in at chezmoi-render time and must
# exist by the time any nu shell starts, which `chezmoi apply` guarantees.
source "{{ .chezmoi.homeDir }}/.local/share/nredf/shell/nushell/functions.bundle"

nredf-init-paths

# OS and WSL are fixed for a machine, so chezmoi renders them here at apply
# time rather than every shell probing for them on startup.
$env.NREDF_OS = "{{ if eq .chezmoi.os "darwin" }}macos{{ else if eq .chezmoi.os "windows" }}windows{{ else }}linux{{ end }}"
$env.NREDF_WSL = "{{ if $isWSL }}true{{ else }}false{{ end }}"

# Shell-behavior toggles from .chezmoidata/shell.yaml, fixed at chezmoi-apply
# time for the same reason as NREDF_OS/NREDF_WSL above. Previously never set
# for nu at all (bash/zsh get these from config.bash, fish's equivalent
# config.fish was never actually generated by chezmoi) — nredf-remote-
# multiplexer and nredf-set-ssh-agent always saw their unset-fallback
# defaults regardless of what shell.yaml said.
$env.NREDF_SHELL_MULTIPLEXER = "{{ .shell.multiplexer }}"
$env.NREDF_SHELL_WSL_MULTIPLEXER = "{{ if hasKey .shell "wsl_multiplexer" }}{{ .shell.wsl_multiplexer }}{{ else }}false{{ end }}"
$env.NREDF_SHELL_SSH_AGENT = "{{ .shell.ssh.agent }}"

# Run on each shell init so child/login shells always inherit a valid SSH_AUTH_SOCK.
nredf-set-ssh-agent

# Restore the Bitwarden session from the keychain, if there is one (silent,
# never prompts) — see AGENTS.md's BW_SESSION rule.
nredf-bw-restore-session

if ($env.NREDF_COMMON_DEFAULTS_DONE? | default "" | is-empty) {
    nredf-set-defaults
    {{- if eq .chezmoi.os "darwin" }}
    $env.HOMEBREW_NO_ANALYTICS = "1"
    $env.HOMEBREW_NO_INSTALL_CLEANUP = "1"
    $env.HOMEBREW_QUIET = "1"
    {{- if eq .chezmoi.arch "arm64" }}
    if ("/opt/homebrew" | path exists) {
        $env.HOMEBREW_PREFIX = "/opt/homebrew"
        $env.HOMEBREW_CELLAR = "/opt/homebrew/Cellar"
        $env.HOMEBREW_REPOSITORY = "/opt/homebrew"
        if not ("/opt/homebrew/bin" in $env.PATH) {
            $env.PATH = ($env.PATH | prepend ["/opt/homebrew/bin" "/opt/homebrew/sbin"])
        }
        $env.INFOPATH = ($env.INFOPATH? | default [] | prepend "/opt/homebrew/share/info")
    }
    {{- else }}
    if ("/usr/local/Homebrew" | path exists) or (("/usr/local/bin/brew" | path exists)) {
        $env.HOMEBREW_PREFIX = "/usr/local"
        $env.HOMEBREW_CELLAR = "/usr/local/Cellar"
        $env.HOMEBREW_REPOSITORY = "/usr/local/Homebrew"
        if not ("/usr/local/bin" in $env.PATH) {
            $env.PATH = ($env.PATH | prepend ["/usr/local/bin" "/usr/local/sbin"])
        }
        $env.INFOPATH = ($env.INFOPATH? | default [] | prepend "/usr/local/share/info")
    }
    {{- end }}
    {{- else if eq .chezmoi.os "linux" }}
    # Linuxbrew support.
    if ("/home/linuxbrew/.linuxbrew" | path exists) {
        $env.HOMEBREW_PREFIX = "/home/linuxbrew/.linuxbrew"
        $env.HOMEBREW_CELLAR = "/home/linuxbrew/.linuxbrew/Cellar"
        $env.HOMEBREW_REPOSITORY = "/home/linuxbrew/.linuxbrew/Homebrew"
        if not ("/home/linuxbrew/.linuxbrew/bin" in $env.PATH) {
            $env.PATH = ($env.PATH | prepend ["/home/linuxbrew/.linuxbrew/bin" "/home/linuxbrew/.linuxbrew/sbin"])
        }
        $env.INFOPATH = ($env.INFOPATH? | default [] | prepend "/home/linuxbrew/.linuxbrew/share/info")
    }
    {{- end }}
    {{- if $isWSL }}

    # WSL: open links in the Windows default browser (see common/rc.tmpl for
    # the bash/zsh copy of this same logic).
    if not (which wslview | is-empty) {
        $env.BROWSER = "wslview"
    } else {
        $env.BROWSER = "cmd.exe /c start"
    }
    {{- end }}

    $env.NREDF_COMMON_DEFAULTS_DONE = "true"
}

# Ensure aqua config env is always present, even if defaults were already marked done.
nredf-set-aqua-env
nredf-set-aqua-path

# nu-specific local env override, at ~/.config/nushell/ like the other shells'
# local overrides (bash: ~/.config/bash/, fish: ~/.config/fish/, ...),
# seeded empty by chezmoi (create_) so a fresh install never fails to source
# it — see docs/shells.md's parity-exceptions section for why nu can't
# support bash's fuller aliases/rc/functions-directory cascade (a missing
# file breaks `source` even inside a runtime `if` guard, since nu parses
# before it runs).
source "{{ .chezmoi.homeDir }}/.config/nushell/env.local.nu"
