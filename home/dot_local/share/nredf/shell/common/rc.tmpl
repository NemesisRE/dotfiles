#!/usr/bin/env bash
#
# vim: ts=2 sw=2 et ff=unix ft=bash syntax=sh
#
# chezmoi-managed common shell rc — sourced by .bashrc / .zshrc / .zprofile / .bash_profile
# No homesick/homeshick references. All paths are relative to ${HOME}.

NREDF_COMMON_RC_PROFILE="${NREDF_COMMON_RC_PROFILE:-full}"

if [[ -n "${ZSH_VERSION:-}" ]]; then
  zmodload -F zsh/datetime b:EPOCHSECONDS b:EPOCHREALTIME 2>/dev/null || true
fi

# Standard 24h throttle interval for all daily operations
NREDF_24H_INTERVAL=86400

_nredf_refresh_cached_shell_snippet() {
  local cache_key="$1"
  local cache_file="$2"
  shift 2

  local needs_refresh=1
  if [[ -s "${cache_file}" ]]; then
    if [[ -n "${ZSH_VERSION:-}" ]] && eval "local -a _m=( \"\${cache_file}\"(Nmh-24) ); (( \${#_m} ))"; then
      needs_refresh=0
    elif _nredf_last_run "${cache_key}"; then
      needs_refresh=0
    fi
  fi

  if (( needs_refresh )); then
    mkdir -p "${cache_file%/*}"
    if "$@" >| "${cache_file}" 2>/dev/null; then
      local now="${EPOCHSECONDS:-}"
      [[ -z "${now}" ]] && now="$(date +%s)"
      _nredf_last_run "${cache_key}" "true" "$((now + NREDF_24H_INTERVAL))"
      if [[ -n "${ZSH_VERSION:-}" ]]; then
        zcompile "${cache_file}" >/dev/null 2>&1 || true
      fi
    else
      rm -f "${cache_file}" "${cache_file}.zwc" 2>/dev/null || true
    fi
  fi

  [[ -s "${cache_file}" ]] && source "${cache_file}"
}


# Load all common function files (fast path: use pre-compiled/bundled file if available)
if [[ -s "${NREDF_DOT_PATH}/shell/common/functions.bundle" ]]; then
  source "${NREDF_DOT_PATH}/shell/common/functions.bundle"
else
  for NREDF_FUNCTIONS in "${NREDF_DOT_PATH}/shell/common/functions/"*; do
    [[ -f "${NREDF_FUNCTIONS}" ]] || continue
    source "${NREDF_FUNCTIONS}"
  done
fi

# Rebuild shell-specific paths on every init so child shells do not inherit
# stale values such as zsh-specific rc paths from the parent environment.
_nredf_init_paths

# Initialize startup profiling (no-op unless NREDF_PROFILE_STARTUP=1 via `reload -p`)
_nredf_profile_init
_nredf_step "source common functions"

_nredf_get_sys_info
_nredf_step "_nredf_get_sys_info"

# Run on each shell init so child/login shells always inherit a valid SSH_AUTH_SOCK.
_nredf_set_ssh_agent
_nredf_step "_nredf_set_ssh_agent"

# NOTE: BW_SESSION is deliberately NOT restored at startup. It is a full vault
# decryption key, and exporting it here leaks it into the environment of every
# child process (npm postinstall, LSPs, build scripts) via /proc/<pid>/environ.
# It also cost 2-4 `security` keychain round-trips on every single shell.
# Both consumers -- `bwu` and the nredf_ssh TOTP helper -- call
# _nredf_bw_ensure_session, which restores from the keychain on demand.

if [[ -z "${NREDF_COMMON_DEFAULTS_DONE}" ]]; then
  _nredf_set_defaults
  _nredf_step "_nredf_set_defaults"
  {{- if eq .chezmoi.os "darwin" }}
  export HOMEBREW_NO_ANALYTICS=1
  export HOMEBREW_NO_INSTALL_CLEANUP=1
  export HOMEBREW_QUIET=1
  {{- if eq .chezmoi.arch "arm64" }}
  if [[ -d /opt/homebrew ]]; then
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
    export HOMEBREW_REPOSITORY="/opt/homebrew"
    case ":${PATH}:" in
      *":/opt/homebrew/bin:/opt/homebrew/sbin:"*) ;;
      *) export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}" ;;
    esac
    [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
    export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
  fi
  {{- else }}
  if [[ -d /usr/local/Homebrew || -x /usr/local/bin/brew ]]; then
    export HOMEBREW_PREFIX="/usr/local"
    export HOMEBREW_CELLAR="/usr/local/Cellar"
    export HOMEBREW_REPOSITORY="/usr/local/Homebrew"
    case ":${PATH}:" in
      *":/usr/local/bin:/usr/local/sbin:"*) ;;
      *) export PATH="/usr/local/bin:/usr/local/sbin${PATH+:$PATH}" ;;
    esac
    [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
    export INFOPATH="/usr/local/share/info:${INFOPATH:-}"
  fi
  {{- end }}
  {{- else if eq .chezmoi.os "linux" }}
  # Linuxbrew support
  if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
    export HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar"
    export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew"
    case ":${PATH}:" in
      *":/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:"*) ;;
      *) export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin${PATH+:$PATH}" ;;
    esac
    [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
    export INFOPATH="/home/linuxbrew/.linuxbrew/share/info:${INFOPATH:-}"
  fi
  {{- end }}


  # config.bash is generated by chezmoi from .chezmoidata/nredf.yaml — source directly
  if [[ -e "${NREDF_CONFIG}/config.bash" ]]; then
    source "${NREDF_CONFIG}/config.bash"
  fi
  _nredf_step "source config.bash"
  _nredf_set_local
  _nredf_step "_nredf_set_local"
  NREDF_COMMON_DEFAULTS_DONE="true"
fi

# Ensure aqua config env is always present, even if defaults were already marked done.
_nredf_set_aqua_env
_nredf_set_aqua_path
_nredf_set_krew_path
_nredf_step "_nredf_set_aqua_env/path + _nredf_set_krew_path"

if [[ "${NREDF_COMMON_RC_PROFILE}" == "login-minimal" ]]; then
  if command -v mise &>/dev/null; then
    eval "$(mise activate "${NREDF_SHELL_NAME}")"
  fi
  _nredf_step "mise activate (login-minimal)"
  return
fi

if [[ "${NREDF_COMMON_RC_PROFILE}" == "interactive-minimal" ]]; then
  source "${NREDF_RC_PATH}/rc"
  _nredf_step "source rc (interactive-minimal)"
  _nredf_os_specific
  _nredf_set_local true
  _nredf_step "_nredf_set_local aliases (interactive-minimal)"
  if command -v atuin &>/dev/null; then
    _nredf_refresh_cached_shell_snippet \
      "_nredf_atuin_init_${NREDF_SHELL_NAME}" \
      "${XDG_CACHE_HOME}/nredf/init/atuin.${NREDF_SHELL_NAME}.sh" \
      atuin init "${NREDF_SHELL_NAME}"
  fi
  _nredf_step "atuin init (interactive-minimal)"
  return
fi

if [[ -z ${SUDO_COMMAND} ]]; then
  _nredf_ensure_aqua_github_token
  _nredf_step "_nredf_ensure_aqua_github_token"
fi

# Shell-specific customization
source "${NREDF_RC_PATH}/rc"
if [[ "${NREDF_SHELL_NAME}" != "zsh" ]]; then
  _nredf_step "source rc"
fi

_nredf_os_specific
_nredf_step "_nredf_os_specific"
_nredf_set_local true
_nredf_step "_nredf_set_local aliases"

# Atuin init — cache shell completion evaluation for 24h
if command -v atuin &>/dev/null; then
  _nredf_refresh_cached_shell_snippet \
    "_nredf_atuin_init_${NREDF_SHELL_NAME}" \
    "${XDG_CACHE_HOME}/nredf/init/atuin.${NREDF_SHELL_NAME}.sh" \
    atuin init "${NREDF_SHELL_NAME}"
fi
_nredf_step "atuin init"

# Mise runtime environment manager (cached snippet for 24h)
if command -v mise &>/dev/null; then
  _nredf_refresh_cached_shell_snippet \
    "_nredf_mise_activate_${NREDF_SHELL_NAME}" \
    "${XDG_CACHE_HOME}/nredf/init/mise.${NREDF_SHELL_NAME}.sh" \
    mise activate "${NREDF_SHELL_NAME}"
fi
_nredf_step "mise activate"


# Zoxide init — replace cd with zoxide, keep z/zi as aliases (cache snippet for 24h)
if command -v zoxide &>/dev/null; then
  _nredf_refresh_cached_shell_snippet \
    "_nredf_zoxide_init_cd_${NREDF_SHELL_NAME}" \
    "${XDG_CACHE_HOME}/nredf/init/zoxide.${NREDF_SHELL_NAME}.sh" \
    zoxide init "${NREDF_SHELL_NAME}" --cmd cd
  alias z="cd" 2>/dev/null || true
  alias zi="cdi" 2>/dev/null || true
fi
_nredf_step "zoxide init"

# Carapace completions — multi-shell multi-command completion generator (cache snippet for 24h)
if command -v carapace &>/dev/null; then
  _nredf_carapace_shell="${NREDF_SHELL_NAME}"
  if [[ "${NREDF_SHELL_NAME}" == "bash" ]] && [[ -f "${XDG_DATA_HOME}/blesh/ble.sh" || -n "${BLE_VERSION-}" ]]; then
    _nredf_carapace_shell="bash-ble"
  fi
  _nredf_refresh_cached_shell_snippet \
    "_nredf_carapace_init_${_nredf_carapace_shell}" \
    "${XDG_CACHE_HOME}/nredf/init/carapace.${_nredf_carapace_shell}.sh" \
    carapace _carapace "${_nredf_carapace_shell}"
  unset _nredf_carapace_shell
fi
_nredf_step "carapace completions"

_nredf_remote_multiplexer
_nredf_step "_nredf_remote_multiplexer"

