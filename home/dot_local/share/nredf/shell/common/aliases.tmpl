#!/usr/bin/env bash
#
# vim: ts=2 sw=2 et ff=unix ft=bash syntax=sh
{{- /* Generated from .chezmoidata/aliases.yaml's nredf_aliases and nredf_commands — keep bash/fish/nu in sync. */}}
{{ range .nredf_aliases.groups }}
{{- if .requires }}
if command -v {{ .requires }} &>/dev/null; then
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
  alias {{ . }}="{{ $cmd }}"
{{- end }}
{{- end }}
fi
{{ else -}}
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
alias {{ . }}="{{ $cmd }}"
{{- end }}
{{- end }}
{{ end -}}
{{- end }}
{{- range .nredf_commands }}
{{- $cmd := .bash }}
{{- range .names }}
alias {{ . }}="{{ $cmd }}"
{{- end }}
{{- end }}
{{- /* User-local additions: ~/.config/nredf/local.yaml, not chezmoi-managed — see docs/shells.md. */}}
{{- $localFile := joinPath .chezmoi.homeDir ".config" "nredf" "local.yaml" }}
{{- $local := dict }}
{{- if stat $localFile }}{{ $local = output "cat" $localFile | fromYaml }}{{ end }}
{{- range (dig "nredf_aliases_local" (list) $local) }}
{{- $cmd := .command }}
{{- range .names }}
alias {{ . }}="{{ $cmd }}"
{{- end }}
{{- end }}
