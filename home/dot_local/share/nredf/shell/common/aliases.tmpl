#!/usr/bin/env bash
#
# vim: ts=2 sw=2 et ff=unix ft=bash syntax=sh
{{- /* Generated from .chezmoidata/aliases.yaml's nredf_aliases — keep bash/fish/nu in sync. */}}
{{ range .nredf_aliases.groups }}
{{- if .requires }}
if command -v {{ .requires }} &>/dev/null; then
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
  alias {{ . }}="{{ $cmd }}"
{{- end }}
{{- end }}
fi
{{ else -}}
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
alias {{ . }}="{{ $cmd }}"
{{- end }}
{{- end }}
{{ end -}}
{{- end }}
alias root="sudo -E \"HOME=\${HOME}\" su -m"
alias aptall="sudo apt update && sudo apt full-upgrade -y; sudo apt autoremove --purge -y; sudo apt autoclean"
alias dipls="docker ps -q | xargs docker inspect --format '{{"{{"}}range .NetworkSettings.Networks{{"}}"}}{{"{{"}}.IPAddress{{"}}"}}{{"{{"}}end{{"}}"}}{{"{{"}}.Name{{"}}"}}' | sed -e 's/^\//HOST\t\//' -e 's/\//\t/g' | sort -n -t . -k 1,1 -k 2,2 -k 3,3 -k 4,4"
alias reload="_nredf_reload_shell"
