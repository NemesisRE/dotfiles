{{- /* Generated from .chezmoidata/aliases.yaml's nredf_aliases and nredf_commands — keep bash/fish/nu/PS in sync. */}}
{{ range .nredf_aliases.groups -}}
{{- $requires := .requires }}
{{- if $requires }}
if (Get-Command {{ $requires }} -ErrorAction SilentlyContinue) {
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
{{- if contains " " $cmd }}
  function {{ . }} { {{ $cmd }} @args }
{{- else }}
  Set-Alias -Name {{ . }} -Value {{ $cmd }} -Option AllScope -Force
{{- end }}
{{- end }}
{{- end }}
}
{{ else -}}
{{- range .aliases }}
{{- if .ps }}
{{- $cmd := .command }}
if (Get-Command {{ first (splitList " " $cmd) }} -ErrorAction SilentlyContinue) {
{{- range .names }}
{{- if contains " " $cmd }}
  function {{ . }} { {{ $cmd }} @args }
{{- else }}
  Set-Alias -Name {{ . }} -Value {{ $cmd }} -Option AllScope -Force
{{- end }}
{{- end }}
}
{{ end -}}
{{- end -}}
{{ end -}}
{{- end }}
{{- range .nredf_commands }}
{{- $ps := .ps }}
{{- $name := index .names 0 }}
{{- if and (hasKey . "ps_requires") .ps_requires }}
if (Get-Command {{ .ps_requires }} -ErrorAction SilentlyContinue) {
function {{ $name }} {
{{ $ps | trimSuffix "\n" | indent 2 }}
}
}
{{ else -}}
function {{ $name }} {
{{ $ps | trimSuffix "\n" | indent 2 }}
}
{{ end -}}
{{- end }}
{{- /* User-local additions: ~/.config/nredf/local.yaml, not chezmoi-managed — see docs/shells.md. */}}
{{- $localFile := joinPath .chezmoi.homeDir ".config" "nredf" "local.yaml" }}
{{- $local := dict }}
{{- if stat $localFile }}{{ $local = output "cat" $localFile | fromYaml }}{{ end }}
{{- range (dig "nredf_aliases_local" (list) $local) }}
{{- $cmd := .command }}
if (Get-Command {{ first (splitList " " $cmd) }} -ErrorAction SilentlyContinue) {
{{- range .names }}
{{- if contains " " $cmd }}
  function {{ . }} { {{ $cmd }} @args }
{{- else }}
  Set-Alias -Name {{ . }} -Value {{ $cmd }} -Option AllScope -Force
{{- end }}
{{- end }}
}
{{ end -}}
# Utility command parity (which, touch)
if (-not (Get-Command which -ErrorAction SilentlyContinue)) {
  function which { Get-Command @args }
}
if (-not (Get-Command touch -ErrorAction SilentlyContinue)) {
  function touch {
    foreach ($file in $args) {
      if (Test-Path $file) {
        (Get-Item $file).LastWriteTime = Get-Date
      } else {
        New-Item -ItemType File -Path $file -Force | Out-Null
      }
    }
  }
}

