# chezmoi-generated monolithic bundle of all common NREDF PowerShell functions.
# Generated on chezmoi apply — loaded in <10ms on PowerShell startup.
#
# The file list is derived from the Functions/ directory rather than hand-kept:
# Sources.ps1 only falls back to enumerating Functions/*.ps1 when this bundle is
# ABSENT, so a file missing from the list here would be silently never loaded.
{{ $dir := "dot_local/share/nredf/shell/pwsh/Functions" -}}
{{ range (glob (joinPath .chezmoi.sourceDir $dir "*.ps1")) -}}
{{- $rel := printf "%s/%s" $dir (base .) }}
{{ include $rel -}}
{{ end -}}

