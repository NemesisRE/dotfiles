#!/usr/bin/env fish
#
# vim: ts=4 sw=4 et ft=fish
#
# Fish has no sibling shell to share a literal alias file with — this whole
# file is generated from .chezmoidata/aliases.yaml (keep bash/fish/nu in
# sync there, not here): `nredf_aliases.groups` below, then
# `nredf_commands` (fish has no `&&`/`||`, so those become `; and`/`; or`
# in that data's `fish` field).
{{ range .nredf_aliases.groups }}
{{- if .requires }}
if type -q {{ .requires }}
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
    alias {{ . }} "{{ $cmd }}"
{{- end }}
{{- end }}
end
{{ else -}}
{{- range .aliases }}
{{- $cmd := .command }}
{{- range .names }}
alias {{ . }} "{{ $cmd }}"
{{- end }}
{{- end }}
{{ end -}}
{{- end }}
{{- range .nredf_commands }}
{{- $cmd := .fish }}
{{- range .names }}
alias {{ . }} "{{ $cmd }}"
{{- end }}
{{- end }}
