# chezmoi-managed nu config.nu — interactive half of the nu entry point.
# Sourced by one of the thin per-OS stubs, after env.nu. See env.nu.tmpl for
# why nu collapses bash's common+shell-specific rc split into this pair.
#
# nu itself already skips loading config.nu for a plain non-interactive
# `nu -c` invocation. This file used to also gate everything below on
# `$nu.is-interactive`, as defense in depth against a login-shell invocation
# still loading it non-interactively (`nu --login -c ...`) — removed after
# confirming empirically that it made every tool integration below (atuin,
# carapace, oh-my-posh, mise, zoxide, fzf) silently no-op, since a
# `--login -c` invocation reports `$nu.is-interactive` as false, and there
# is no way here to be certain that report is only ever false in exactly the
# cases it should be. The two operations that actually must never run non-
# interactively (the aqua GitHub-token wizard, zellij auto-attach) already
# have their own independent, more direct guards — see
# nredf-ensure-aqua-github-token and nredf-remote-multiplexer — so this
# outer check was redundant protection with a proven cost, not a needed one.

source "{{ .chezmoi.homeDir }}/.local/share/nredf/shell/nu/aliases.nu"

# Nu prints its "Welcome to Nushell" ASCII banner (version, links, uptime
# since nu's first commit, ...) on every interactive startup unless told
# not to — bash/zsh/fish/PowerShell have no equivalent noise to suppress.
$env.config.show_banner = false

nredf-profile-init
nredf-step "config.nu start"

if ($env.SUDO_COMMAND? | default "" | is-empty) {
    nredf-ensure-aqua-github-token
    nredf-step "nredf-ensure-aqua-github-token"
}

# oh-my-posh prompt. Unlike every other tool integration below, oh-my-posh's
# nu support doesn't print an init script for us to cache and `source` at
# all — confirmed empirically (its stdout and stderr are both genuinely
# empty on success) — it writes directly into nu's own vendor-autoload
# directory (~/.local/share/nushell/vendor/autoload/, one of
# $nu.vendor-autoload-dirs), which nu sources automatically on every
# startup with no `source` call needed from here. So this only has to
# periodically re-run the generator (same 24h cadence as the cached-snippet
# tools); the same one-restart lag documented for those applies here too,
# since nu only re-scans vendor-autoload at its own next startup.
if (not (which oh-my-posh | is-empty)) and (($env.XDG_CONFIG_HOME | path join "oh-my-posh" "config.json") | path exists) {
    if not (nredf-last-run "nredf_omp_init_nu") {
        ^oh-my-posh init nu --config ($env.XDG_CONFIG_HOME | path join "oh-my-posh" "config.json") | ignore
        nredf-last-run "nredf_omp_init_nu" --success --next $env.NREDF_24H_INTERVAL
    }
}
nredf-step "oh-my-posh init"

# Atuin init — cache shell integration for 24h. Reedline resolves two
# keybindings mapped to the same key by last-one-wins (confirmed:
# nushell/nushell#9867), so atuin's "atuin" entry — appended after nu's own
# shipped "history_menu" default for Ctrl+R — already takes over that key
# with no extra work needed here.
if not (which atuin | is-empty) {
    nredf-cache-refresh "nredf_atuin_init_nu" "{{ .chezmoi.homeDir }}/.cache/nredf/init/atuin.nu" { ^atuin init nu }
    # But fzf's own nu integration (sourced further below) *also* binds
    # Ctrl+R unless FZF_CTRL_R_COMMAND is explicitly set (even to empty),
    # and it runs after atuin — so left alone, fzf's later entry would win
    # instead. Suppress it so atuin keeps Ctrl+R, matching bash/zsh/fish
    # (see nredf_tool_fzf.fish for the same reasoning there).
    $env.FZF_CTRL_R_COMMAND = ""
}
source "{{ .chezmoi.homeDir }}/.cache/nredf/init/atuin.nu"
nredf-step "atuin init"

# Mise runtime environment manager (cached snippet for 24h).
if not (which mise | is-empty) {
    nredf-cache-refresh "nredf_mise_activate_nu" "{{ .chezmoi.homeDir }}/.cache/nredf/init/mise.nu" { ^mise activate nu }
}
source "{{ .chezmoi.homeDir }}/.cache/nredf/init/mise.nu"
nredf-step "mise activate"

# Zoxide init (`z`/`zi`). NOTE: zoxide does not support replacing `cd` on
# nushell at all (upstream limitation, not this repo's — see
# docs/shells.md's parity-exceptions section), so unlike bash/zsh/fish there
# is no `--cmd cd` here and no `cd` alias to it.
if not (which zoxide | is-empty) {
    nredf-cache-refresh "nredf_zoxide_init_nu" "{{ .chezmoi.homeDir }}/.cache/nredf/init/zoxide.nu" { ^zoxide init nushell }
}
source "{{ .chezmoi.homeDir }}/.cache/nredf/init/zoxide.nu"
nredf-step "zoxide init"

# Carapace completions — multi-shell multi-command completion generator
# (cache snippet for 24h). This is also nu's *only* fuzzy-completion story:
# the Ctrl+Space fzf-tab widget bash/zsh/fish get is not achievable in nu —
# Reedline has no primitive to replace the edit buffer with an external
# filter's output — so carapace's native Tab-completion menu is what nu gets
# instead. See docs/shells.md's parity-exceptions section.
if not (which carapace | is-empty) {
    nredf-cache-refresh "nredf_carapace_init_nu" "{{ .chezmoi.homeDir }}/.cache/nredf/init/carapace.nu" { ^carapace _carapace nushell }
}
source "{{ .chezmoi.homeDir }}/.cache/nredf/init/carapace.nu"
nredf-step "carapace completions"

# fzf Ctrl+T / Alt+C / Ctrl+R keybindings (not the Ctrl+Space tab-complete
# widget, which nu cannot have — see above). fzf ships real nu integration
# for these (`fzf --nushell`).
if not (which fzf | is-empty) {
    nredf-cache-refresh "nredf_fzf_init_nu" "{{ .chezmoi.homeDir }}/.cache/nredf/init/fzf.nu" { ^fzf --nushell }
}
source "{{ .chezmoi.homeDir }}/.cache/nredf/init/fzf.nu"
nredf-step "fzf keybindings"

# kitty has no nushell shell-integration upstream at all (fish and zsh/bash
# do) — documented upstream gap, not something this repo can fix; see
# docs/shells.md's parity-exceptions section.

nredf-remote-multiplexer
nredf-step "nredf-remote-multiplexer"

# nu-specific local interactive-config override, at ~/.config/nu/ like
# env.local.nu — seeded empty by chezmoi (create_); see env.nu.tmpl's
# comment for why nu needs a pre-seeded placeholder here instead of the
# other shells' fuller local-override files.
source "{{ .chezmoi.homeDir }}/.config/nu/config.local.nu"

nredf-profile-finish
