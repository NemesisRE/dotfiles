#!/usr/bin/env bash
#
# vim: ts=2 sw=2 et ff=unix ft=bash syntax=sh
# chezmoi-managed bash-specific rc — sourced by shell/common/rc via NREDF_RC_PATH

if ! shopt -oq posix; then
{{- if eq .chezmoi.os "darwin" }}
{{- if eq .chezmoi.arch "arm64" }}
  if [[ -f "/opt/homebrew/etc/profile.d/bash_completion.sh" ]]; then
    source "/opt/homebrew/etc/profile.d/bash_completion.sh"
  elif [[ -f "/opt/homebrew/share/bash-completion/bash_completion" ]]; then
    source "/opt/homebrew/share/bash-completion/bash_completion"
  fi
{{- else }}
  if [[ -f "/usr/local/etc/profile.d/bash_completion.sh" ]]; then
    source "/usr/local/etc/profile.d/bash_completion.sh"
  elif [[ -f "/usr/local/share/bash-completion/bash_completion" ]]; then
    source "/usr/local/share/bash-completion/bash_completion"
  fi
{{- end }}
{{- else if eq .chezmoi.os "linux" }}
  if [[ -f "/etc/profile.d/bash_completion.sh" ]]; then
    source "/etc/profile.d/bash_completion.sh"
  elif [[ -f "/etc/bash_completion" ]]; then
    source "/etc/bash_completion"
  fi
{{- end }}
fi

# Disable CTRL-S & CTRL-Q flow control
stty stop '' start '' -ixon -ixoff 2>/dev/null || true

# History Settings
HISTCONTROL=ignoreboth
HISTTIMEFORMAT="%d/%m/%y %T "
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s checkwinsize

# Write history after every command
PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a"

if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )) && command -v oh-my-posh &>/dev/null && [[ -f "${XDG_CONFIG_HOME}/oh-my-posh/config.json" ]]; then
  _nredf_omp_bash_init_file="${XDG_CACHE_HOME}/nredf/init/omp.bash.sh"
  if [[ -z "${POSH_SESSION_ID:-}" ]]; then
    export POSH_SESSION_ID="${RANDOM:-$$}-$$-${EPOCHSECONDS:-0}"
  fi
  _nredf_omp_gen_bash() {
    oh-my-posh init bash --config "${XDG_CONFIG_HOME}/oh-my-posh/config.json" 2>/dev/null | sed -E 's/export POSH_SESSION_ID="[^"]*"; ?//'
  }
  _nredf_refresh_cached_shell_snippet \
    "_nredf_omp_init_bash" \
    "${_nredf_omp_bash_init_file}" \
    _nredf_omp_gen_bash
  unset -f _nredf_omp_gen_bash 2>/dev/null || true
  unset _nredf_omp_bash_init_file
fi


