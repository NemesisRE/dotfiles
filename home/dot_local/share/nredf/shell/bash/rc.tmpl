#!/usr/bin/env bash
#
# vim: ts=2 sw=2 et ff=unix ft=bash syntax=sh
# chezmoi-managed bash-specific rc — sourced by shell/common/rc via NREDF_RC_PATH

if [ -f /etc/bash_completion ] && ! shopt -oq posix; then
  source /etc/bash_completion
fi

if [ -f /etc/profile.d/bash_completion.sh ]; then
  source /etc/profile.d/bash_completion.sh
fi

if [ -f /opt/homebrew/etc/profile.d/bash_completion.sh ]; then
  source /opt/homebrew/etc/profile.d/bash_completion.sh
fi

if [ -f /usr/local/etc/profile.d/bash_completion.sh ]; then
  source /usr/local/etc/profile.d/bash_completion.sh
fi

if [ -f /opt/homebrew/share/bash-completion/bash_completion ]; then
  source /opt/homebrew/share/bash-completion/bash_completion
fi

if [ -f /usr/local/share/bash-completion/bash_completion ]; then
  source /usr/local/share/bash-completion/bash_completion
fi

# Disable CTRL-S & CTRL-Q flow control
stty stop '' 2>/dev/null || true
stty start '' 2>/dev/null || true
stty -ixon 2>/dev/null || true
stty -ixoff 2>/dev/null || true

# History Settings
HISTCONTROL=ignoreboth
HISTTIMEFORMAT="%d/%m/%y %T "
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s checkwinsize

# Write history after every command
PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a"

if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )) && command -v oh-my-posh &>/dev/null && [[ -f "${XDG_CONFIG_HOME}/oh-my-posh/config.json" ]]; then
  eval "$(oh-my-posh init bash --config "${XDG_CONFIG_HOME}/oh-my-posh/config.json")"
fi

# Dynamic completions
if [[ -d "${XDG_CONFIG_HOME}/completion/bash" ]]; then
  for NREDF_BASH_COMPLETION in "${XDG_CONFIG_HOME}/completion/bash/"*; do
    [[ -f "${NREDF_BASH_COMPLETION}" ]] || continue
    # shellcheck disable=SC1090
    source "${NREDF_BASH_COMPLETION}" 2>/dev/null || true
  done
fi

trap _unsudo exit
