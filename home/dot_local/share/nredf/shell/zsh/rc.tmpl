#!/usr/bin/env zsh
# chezmoi-managed zsh/rc

if (( ! ${+functions[_nredf_step]} )); then
  _nredf_step() { :; }
fi

[[ ! -d "${XDG_STATE_HOME}/zsh" ]] && mkdir -p "${XDG_STATE_HOME}/zsh"
[[ ! -d "${XDG_CACHE_HOME}/zsh" ]] && mkdir -p "${XDG_CACHE_HOME}/zsh"
_nredf_step "zsh rc: dirs"

if (( ! ${+functions[_nredf_load_sheldon_plugins]} )); then
  export NREDF_RC_PATH="${NREDF_RC_PATH:-${NREDF_DOT_PATH}/shell/${NREDF_SHELL_NAME}}"

  if (( ! ${+functions[_nredf_init_paths]} )); then
    source "${NREDF_DOT_PATH}/shell/common/functions/nredf_init_paths.bash"
  fi
  _nredf_init_paths

  [[ -f "${NREDF_RC_PATH}/functions" ]] && source "${NREDF_RC_PATH}/functions"
fi
_nredf_step "zsh rc: source functions"

# Byte-compile common functions bundle if modified
local _bundle="${NREDF_DOT_PATH}/shell/common/functions.bundle"
if [[ -s "${_bundle}" && ( ! -f "${_bundle}.zwc" || "${_bundle}" -nt "${_bundle}.zwc" ) ]]; then
  zcompile "${_bundle}" 2>/dev/null || true
fi
unset _bundle

export HISTFILE="${XDG_STATE_HOME}"/zsh/history

autoload -Uz compinit
NREDF_ZCOMPDUMP="${XDG_CACHE_HOME}/zsh/.zcompdump"
NREDF_DOCKER_COMPLETION="/usr/share/zsh/vendor-completions/_docker"
_nredf_compinit() {
  if [[ -L "${NREDF_DOCKER_COMPLETION}" && ! -e "${NREDF_DOCKER_COMPLETION}" ]]; then
    compinit "$@" 2> >(grep -v -F -- "${NREDF_DOCKER_COMPLETION}" >&2)
  else
    compinit "$@"
  fi
}

# Fast path: use cached completion dump; refresh only every 24h.
if [[ -f "${NREDF_ZCOMPDUMP}" ]] && (( ${+functions[_nredf_last_run]} )) && _nredf_last_run "_nredf_zsh_compinit_refresh"; then
  _nredf_compinit -C -d "${NREDF_ZCOMPDUMP}"
else
  _nredf_compinit -u -d "${NREDF_ZCOMPDUMP}"
  if (( ${+functions[_nredf_last_run]} )); then
    _nredf_last_run "_nredf_zsh_compinit_refresh" "true" "86400"
  fi
  zcompile "${NREDF_ZCOMPDUMP}" >/dev/null 2>&1 || true
fi


zstyle ':completion:*' cache-path "${XDG_CACHE_HOME}/zsh/zcompcache"
zstyle -e ':completion:*' special-dirs '[[ $PREFIX = (../)#(|.|..) ]] && reply=(..)'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:*' fzf-flags --ansi
zstyle ':fzf-tab:*' fzf-bindings 'tab:down' 'btab:up'
zmodload zsh/mathfunc
_nredf_step "zsh rc: compinit"
