{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_once_before Windows hook — installs aqua and links managed tools.
# https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/

# Was 'SilentlyContinue' for the whole installer, which hid every failure and then
# printed "done" regardless. Commands that may legitimately fail say so explicitly.
$ErrorActionPreference = 'Continue'

if ($env:CI -or $env:NREDF_NO_BOOTSTRAP) {
    exit 0
}

{{ includeTemplate "hook-env.ps1" . }}

$localBin = Join-Path $HOME ".local\bin"
if (-not (Test-Path $localBin)) {
    New-Item -ItemType Directory -Path $localBin -Force | Out-Null
}

# Pinned in .chezmoidata/aqua-bootstrap.yaml, for winget and the zip fallback alike;
# winget used to install whatever release was newest.
$aquaVersion = "{{ .aquaBootstrap.version }}"

# winget exits non-zero when there is simply nothing to do. Same list as
# run_onchange_before_windows_install-packages.ps1.tmpl and bootstrap.ps1's
# Test-WingetSuccess, kept in sync by hand since a run_once_before hook can't
# includeTemplate a helper function usably before it is defined at this point.
$wingetBenignCodes = @(
    -1978335189 # 0x8A15002B UPDATE_NOT_APPLICABLE
    -1978335135 # 0x8A150061 PACKAGE_ALREADY_INSTALLED
    -1978334963 # 0x8A15010D INSTALL_ALREADY_INSTALLED
    -1978334967 # 0x8A150109 INSTALL_REBOOT_REQUIRED_TO_FINISH
)

# Install aqua if missing
if (-not (Get-Command aqua -ErrorAction SilentlyContinue)) {
    Write-Host "==> Installing aqua $aquaVersion for Windows"
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        & winget install --id aquaproj.aqua --exact --version "{{ trimPrefix "v" .aquaBootstrap.version }}" --silent --accept-source-agreements --accept-package-agreements
        $wingetCode = $LASTEXITCODE
        if ($wingetCode -ne 0 -and $wingetBenignCodes -notcontains $wingetCode) {
            Write-Warning ("winget install aquaproj.aqua exited with code {0} (0x{0:X8}); trying the pinned GitHub release." -f $wingetCode)
        }
        # winget's portable-package link dir is added to the User PATH, not this process's.
        NREDF_HookEnv
    }
    if (-not (Get-Command aqua -ErrorAction SilentlyContinue)) {
        # Fallback when winget is unavailable or failed. This used to download
        # `releases/latest` and execute whatever came back. Now: a pinned release whose
        # zip must match a pinned SHA-256 (.chezmoidata/aqua-bootstrap.yaml), otherwise
        # it is rejected.
        $arch = if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64') { 'arm64' } else { 'amd64' }
        $aquaSha256 = if ($arch -eq 'arm64') { "{{ .aquaBootstrap.windows.arm64 }}" } else { "{{ .aquaBootstrap.windows.amd64 }}" }
        $aquaReleaseUrl = "https://github.com/aquaproj/aqua/releases/download/${aquaVersion}/aqua_windows_${arch}.zip"
        $tmpZip = Join-Path ([System.IO.Path]::GetTempPath()) "aqua_bootstrap.zip"
        $tmpExtract = Join-Path ([System.IO.Path]::GetTempPath()) "aqua_extract"
        try {
            Invoke-WebRequest -Uri $aquaReleaseUrl -OutFile $tmpZip -ErrorAction Stop
            $actualSha256 = (Get-FileHash -Algorithm SHA256 -LiteralPath $tmpZip -ErrorAction Stop).Hash
            if ($actualSha256 -ne $aquaSha256) {
                throw "aqua $aquaVersion checksum mismatch (expected $aquaSha256, got $actualSha256); refusing to install"
            }
            Expand-Archive -Path $tmpZip -DestinationPath $tmpExtract -Force -ErrorAction Stop
            Copy-Item -Path (Join-Path $tmpExtract "aqua.exe") -Destination (Join-Path $localBin "aqua.exe") -Force -ErrorAction Stop
        } catch {
            Write-Warning "Could not install aqua from GitHub releases: $_"
        } finally {
            Remove-Item -Path $tmpZip, $tmpExtract -Recurse -Force -ErrorAction SilentlyContinue
        }
    }
}

if (Get-Command aqua -ErrorAction SilentlyContinue) {
    Write-Host "==> aqua install -a -l (link managed tools)"
    # A before-hook runs before chezmoi has written ~/.config, so on the first apply
    # point aqua at the source-state copy of aqua.yaml instead.
    if (-not ($env:AQUA_CONFIG -and (Test-Path -LiteralPath $env:AQUA_CONFIG))) {
        $sourceAqua = Join-Path '{{ .chezmoi.sourceDir | replace "'" "''" }}' "dot_config\aquaproj-aqua\aqua.yaml"
        if (Test-Path -LiteralPath $sourceAqua) {
            $env:AQUA_GLOBAL_CONFIG = $sourceAqua
            $env:AQUA_CONFIG = $sourceAqua
        }
    }
    & aqua install -a -l
    if ($LASTEXITCODE -eq 0) {
        Write-Host "==> Windows bootstrap hook done."
    } else {
        Write-Warning "aqua install exited with code $LASTEXITCODE; tools may be missing or stale."
    }
} else {
    Write-Warning "aqua is not installed; managed tools were not linked."
}
exit 0
{{- end }}
