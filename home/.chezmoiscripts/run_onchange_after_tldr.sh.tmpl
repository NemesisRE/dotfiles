{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_after hook — updates tldr pages cache on aqua package updates.
# aqua.yaml hash: {{ include "dot_config/aquaproj-aqua/aqua.yaml" | sha256sum }}

set -euo pipefail

[[ -n "${CI:-}" ]] && exit 0
[[ -n "${NREDF_NO_BOOTSTRAP:-}" ]] && exit 0

LOCAL_BIN="${HOME}/.local/bin"
AQUA_BIN="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/aquaproj-aqua}/bin"
export PATH="${LOCAL_BIN}:${AQUA_BIN}:${PATH}"

if command -v tldr >/dev/null 2>&1; then
  echo "==> Updating tldr cache"
  tldr --update || true
fi
{{- end }}
