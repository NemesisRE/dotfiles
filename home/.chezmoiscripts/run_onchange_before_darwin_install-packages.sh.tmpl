{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_before — installs Homebrew and prerequisite packages on macOS.
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

# Skip in CI or when the user explicitly opts out.
[[ -n "${CI:-}" ]] && exit 0
[[ -n "${NREDF_NO_BOOTSTRAP:-}" ]] && exit 0

# This is a `before` script, so a non-zero exit aborts `chezmoi apply` before a
# single dotfile is written. A failing formula, an offline machine or a declined
# installer must therefore degrade to a warning, not an abort.
WARNINGS=0
warn() {
  echo "==> Warning: $*" >&2
  WARNINGS=$((WARNINGS + 1))
}

# ── Xcode Command Line Tools (Apple Clang compiler for Tree-sitter) ───────────
if ! xcode-select -p >/dev/null 2>&1; then
  echo "==> Installing Xcode Command Line Tools (required for C/C++ compiler and Tree-sitter)"
  # `xcode-select --install` only opens the GUI installer and returns at once, so
  # brew below would run with no compiler. Wait for it -- but only if the
  # installer actually launched (it fails fast over ssh / without a GUI), and not
  # forever if the dialog is ignored.
  if xcode-select --install >/dev/null 2>&1; then
    waited=0
    until xcode-select -p >/dev/null 2>&1 || (( waited >= 900 )); do
      sleep 5
      waited=$((waited + 5))
    done
    xcode-select -p >/dev/null 2>&1 || warn "Command Line Tools not installed after 15 min; continuing"
  else
    warn "could not launch the Command Line Tools installer; continuing"
  fi
fi

# ── Homebrew ──────────────────────────────────────────────────────────────────
if ! command -v brew >/dev/null 2>&1 && [[ ! -x /opt/homebrew/bin/brew && ! -x /usr/local/bin/brew ]]; then
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || true
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Warning: Homebrew could not be located; skipping brew bundle"
  exit 0
fi

# Homebrew environment variables to keep execution clean
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_QUIET=1

echo "==> Installing and upgrading prerequisite packages via Homebrew bundle"
brew bundle install --force --file=- <<BREW_BUNDLE_EOF || warn "brew bundle reported failures; continuing"
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
BREW_BUNDLE_EOF

echo "==> Cleaning up Homebrew cache"
brew cleanup >/dev/null 2>&1 || true

if (( WARNINGS > 0 )); then
  echo "==> macOS prerequisites finished with ${WARNINGS} warning(s); see above."
else
  echo "==> macOS prerequisites installed and updated successfully."
fi
{{- end }}
