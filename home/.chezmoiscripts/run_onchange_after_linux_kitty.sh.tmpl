{{- if eq .chezmoi.os "linux" -}}
{{- if not (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{- $quakeKey := "F12" -}}
{{- if and (hasKey . "kitty") (hasKey .kitty "quake_key") -}}
{{-   $quakeKey = .kitty.quake_key -}}
{{- end -}}
#!/usr/bin/env bash
# chezmoi run_onchange_after — ensures installed Kitty on Linux matches desired state (excludes WSL)
# kitty.yaml hash: {{ include ".chezmoidata/kitty.yaml" | sha256sum }}

set -euo pipefail

# Skip in CI or when the user explicitly opts out.
[[ -n "${CI:-}" ]] && exit 0
[[ -n "${NREDF_NO_BOOTSTRAP:-}" ]] && exit 0

# Runtime safety check: skip if running inside WSL
if [[ -n "${WSL_DISTRO_NAME:-}" || -n "${WSL_INTEROP:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
  exit 0
fi

LOCAL_BIN="${HOME}/.local/bin"
KITTY_APP="${HOME}/.local/kitty.app"
DESKTOP_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/applications"
ICONS_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/icons/hicolor/256x256/apps"
TARGET_VERSION="{{ trimPrefix "v" .kitty.version }}"

mkdir -p "${LOCAL_BIN}" "${DESKTOP_DIR}" "${ICONS_DIR}"

# Clean up any nested kitty.app directory if created by prior buggy dest argument
if [[ -d "${KITTY_APP}/kitty.app" ]]; then
  echo "==> Cleaning up nested ${KITTY_APP}/kitty.app directory"
  rm -rf "${KITTY_APP}/kitty.app"
fi

# Check reality: what version is actually installed?
CURRENT_VERSION=""
if [[ -x "${KITTY_APP}/bin/kitty" ]]; then
  CURRENT_VERSION="$("${KITTY_APP}/bin/kitty" --version 2>/dev/null | awk '{print $2}' || true)"
fi

# Install the pinned release archive from GitHub, verified against the SHA-256 in
# .chezmoidata/kitty.yaml. This replaces piping sw.kovidgoyal.net/kitty/installer.sh
# into `sh`, which ran an unpinned, unverified script and, through it, an
# unverified archive. The archive holds bin/ lib/ share/ at its root, which is
# exactly the layout of ~/.local/kitty.app.
#
# NOTE: this is a subshell function called from an `if !` condition, where bash
# silently disables `set -e` -- so every step below needs an explicit `|| exit 1`.
install_kitty() (
  arch="" expected=""
  case "$(uname -m)" in
    x86_64) arch="x86_64" expected="{{ .kitty.sha256.x86_64 }}" ;;
    aarch64 | arm64) arch="arm64" expected="{{ .kitty.sha256.arm64 }}" ;;
    *)
      echo "==> Warning: no pinned Kitty build for $(uname -m)" >&2
      exit 1
      ;;
  esac
  url="https://github.com/kovidgoyal/kitty/releases/download/v${TARGET_VERSION}/kitty-${TARGET_VERSION}-${arch}.txz"

  # Same filesystem as the destination, so the final `mv` is an atomic rename.
  mkdir -p "${HOME}/.local" || exit 1
  tmp="$(mktemp -d "${HOME}/.local/.kitty-install.XXXXXX")" || exit 1
  trap 'rm -rf "${tmp}"' EXIT

  curl --proto '=https' --tlsv1.2 -sSfL "${url}" -o "${tmp}/kitty.txz" || {
    echo "==> Warning: could not download ${url}" >&2
    exit 1
  }
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "${tmp}/kitty.txz" | awk '{print $1}')" || exit 1
  else
    actual="$(shasum -a 256 "${tmp}/kitty.txz" | awk '{print $1}')" || exit 1
  fi
  if [[ "${actual}" != "${expected}" ]]; then
    echo "==> Error: Kitty ${TARGET_VERSION} checksum mismatch; refusing to install." >&2
    echo "    expected ${expected}" >&2
    echo "    actual   ${actual}" >&2
    exit 1
  fi

  mkdir "${tmp}/app" || exit 1
  tar -xJf "${tmp}/kitty.txz" -C "${tmp}/app" || exit 1
  [[ -x "${tmp}/app/bin/kitty" ]] || {
    echo "==> Error: unexpected Kitty archive layout (no bin/kitty)" >&2
    exit 1
  }
  rm -rf "${KITTY_APP}" || exit 1
  mv "${tmp}/app" "${KITTY_APP}" || exit 1
)

if [[ "${CURRENT_VERSION}" != "${TARGET_VERSION}" ]]; then
  echo "==> Kitty version mismatch (installed: '${CURRENT_VERSION:-none}', desired: '${TARGET_VERSION}')"
  echo "    Installing / updating Kitty to ${TARGET_VERSION} (checksum-verified release archive)..."
  if ! install_kitty; then
    echo "==> Warning: Kitty ${TARGET_VERSION} was not installed; keeping any existing install" >&2
    # Nothing to configure below if there is no Kitty at all.
    [[ -x "${KITTY_APP}/bin/kitty" ]] || exit 0
  fi
fi

# Ensure symlinks in ~/.local/bin (in user PATH)
ln -sf "${KITTY_APP}/bin/kitty" "${LOCAL_BIN}/kitty"
ln -sf "${KITTY_APP}/bin/kitten" "${LOCAL_BIN}/kitten"

# Ensure desktop entries and icon
if [[ -f "${KITTY_APP}/share/applications/kitty.desktop" ]]; then
  cp -f "${KITTY_APP}/share/applications/kitty.desktop" "${DESKTOP_DIR}/kitty.desktop"
  sed -i "s|^Exec=kitty|Exec=${LOCAL_BIN}/kitty|g" "${DESKTOP_DIR}/kitty.desktop"
  sed -i "s|^Icon=kitty|Icon=${ICONS_DIR}/kitty.png|g" "${DESKTOP_DIR}/kitty.desktop"
fi

if [[ -f "${KITTY_APP}/share/applications/kitty-open.desktop" ]]; then
  cp -f "${KITTY_APP}/share/applications/kitty-open.desktop" "${DESKTOP_DIR}/kitty-open.desktop"
  sed -i "s|^Exec=kitty|Exec=${LOCAL_BIN}/kitty|g" "${DESKTOP_DIR}/kitty-open.desktop"
  sed -i "s|^Icon=kitty|Icon=${ICONS_DIR}/kitty.png|g" "${DESKTOP_DIR}/kitty-open.desktop"
fi

if [[ -f "${KITTY_APP}/share/icons/hicolor/256x256/apps/kitty.png" ]]; then
  cp -f "${KITTY_APP}/share/icons/hicolor/256x256/apps/kitty.png" "${ICONS_DIR}/kitty.png"
fi

# ── Wayland Quake-Mode / Quick-Access Terminal Helper ────────────────────────
cat <<'QUAKE_EOF' > "${LOCAL_BIN}/kitty-quake"
#!/usr/bin/env bash
# Quake-mode / quick-access drop-down terminal helper for Kitty on Wayland
set -euo pipefail

# Dynamic Wayland socket detection if not already exported
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
    if [[ -S "${sock}" ]]; then
      export WAYLAND_DISPLAY="$(basename "${sock}")"
      break
    fi
  done
fi
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

KITTEN_BIN="${HOME}/.local/kitty.app/bin/kitten"
if [[ ! -x "${KITTEN_BIN}" ]]; then
  KITTEN_BIN="$(command -v kitten 2>/dev/null || echo "${HOME}/.local/bin/kitten")"
fi

exec "${KITTEN_BIN}" quick-access-terminal "$@"
QUAKE_EOF
chmod +x "${LOCAL_BIN}/kitty-quake"
ln -sf "${LOCAL_BIN}/kitty-quake" "${LOCAL_BIN}/kitty-quick-access"

# Desktop launcher for Quake-mode terminal (for desktop shortcut pickers)
cat <<DESKTOP_EOF > "${DESKTOP_DIR}/kitty-quake.desktop"
[Desktop Entry]
Type=Application
Name=Kitty Quake Terminal
GenericName=Quick Access Terminal
Comment=Toggle Quake-style drop-down terminal
Exec=${LOCAL_BIN}/kitty-quake
Icon=${ICONS_DIR}/kitty.png
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;quake;dropdown;quick-access;
StartupNotify=false
X-KDE-GlobalAccel-CommandShortcut=true
DESKTOP_EOF

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "${DESKTOP_DIR}" >/dev/null 2>&1 || true
fi

# Update KDE Sycoca database so KDE and KGlobalAccel immediately index kitty-quake.desktop
if command -v kbuildsycoca6 >/dev/null 2>&1; then
  kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
elif command -v kbuildsycoca5 >/dev/null 2>&1; then
  kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
fi
qdbus org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true

{{- if and (ne $quakeKey "none") (ne $quakeKey "") }}
# ── Global Shortcut Verification & Configuration ({{ $quakeKey }}) ────────────
# 1. KDE Plasma (Wayland / X11)
if command -v kwriteconfig6 >/dev/null 2>&1 || command -v kwriteconfig5 >/dev/null 2>&1; then
  KWRITE="kwriteconfig6"
  KREAD="kreadconfig6"
  if ! command -v kwriteconfig6 >/dev/null 2>&1; then
    KWRITE="kwriteconfig5"
    KREAD="kreadconfig5"
  fi

  CURRENT_SHORTCUT="$(${KREAD} --file kglobalshortcutsrc --group "kitty-quake.desktop" --key "_launch" 2>/dev/null || true)"
  if [[ "${CURRENT_SHORTCUT}" != "{{ $quakeKey }},"* ]]; then
    echo "==> Configuring KDE Plasma global shortcut: {{ $quakeKey }} -> kitty-quake"
    ${KWRITE} --file kglobalshortcutsrc --group "kitty-quake.desktop" --key "_k_friendly_name" "Kitty Quake Terminal"
    ${KWRITE} --file kglobalshortcutsrc --group "kitty-quake.desktop" --key "_launch" "{{ $quakeKey }},none,Kitty Quake Terminal"

    # Reload KWin & KGlobalAccel to ensure the shortcut is immediately active
    qdbus org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
    qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
    systemctl --user restart plasma-kglobalaccel.service >/dev/null 2>&1 || true
  fi
elif [[ -f "${HOME}/.config/kglobalshortcutsrc" ]]; then
  # Direct configuration fallback if CLI tools are not installed
  if ! grep -q "\[kitty-quake.desktop\]" "${HOME}/.config/kglobalshortcutsrc" 2>/dev/null; then
    echo "==> Injecting [kitty-quake.desktop] shortcut into ~/.config/kglobalshortcutsrc"
    cat <<'KDE_EOF' >> "${HOME}/.config/kglobalshortcutsrc"

[kitty-quake.desktop]
_k_friendly_name=Kitty Quake Terminal
_launch={{ $quakeKey }},none,Kitty Quake Terminal
KDE_EOF
    systemctl --user restart plasma-kglobalaccel.service >/dev/null 2>&1 || true
  fi
fi

# 2. GNOME Desktop (Wayland / X11)
if command -v gsettings >/dev/null 2>&1 && [[ "${XDG_CURRENT_DESKTOP:-}" =~ [Gg][Nn][Oo][Mm][Ee] ]]; then
  GNOME_KB_PATH="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kitty-quake/"
  CURRENT_KB_LIST="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo '[]')"
  if [[ "${CURRENT_KB_LIST}" != *"${GNOME_KB_PATH}"* ]]; then
    echo "==> Registering GNOME custom keybinding for kitty-quake"
    NEW_KB_LIST="$(echo "${CURRENT_KB_LIST}" | sed "s|]$|, '${GNOME_KB_PATH}']|; s|\[, |[|")"
    gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "${NEW_KB_LIST}" 2>/dev/null || true
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${GNOME_KB_PATH}" name "Kitty Quake Terminal" 2>/dev/null || true
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${GNOME_KB_PATH}" command "${LOCAL_BIN}/kitty-quake" 2>/dev/null || true
    gsettings set "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${GNOME_KB_PATH}" binding "{{ $quakeKey }}" 2>/dev/null || true
  fi
fi
{{- else }}
# Quake shortcut disabled; clearing any existing KDE shortcut for kitty-quake
if command -v kwriteconfig6 >/dev/null 2>&1; then
  kwriteconfig6 --file kglobalshortcutsrc --group "kitty-quake.desktop" --key "_launch" "none,none,Kitty Quake Terminal"
  systemctl --user restart plasma-kglobalaccel.service >/dev/null 2>&1 || true
elif command -v kwriteconfig5 >/dev/null 2>&1; then
  kwriteconfig5 --file kglobalshortcutsrc --group "kitty-quake.desktop" --key "_launch" "none,none,Kitty Quake Terminal"
  systemctl --user restart plasma-kglobalaccel.service >/dev/null 2>&1 || true
fi
{{- end }}
{{- end }}
{{- end -}}
