{{- if and (eq .chezmoi.os "windows") (hasKey . "windows") (hasKey .windows "explorer") (hasKey .windows.explorer "apply_tweaks") .windows.explorer.apply_tweaks -}}
# chezmoi run_onchange_after Windows hook — applies File Explorer developer tweaks.
# explorer.apply_tweaks: {{ .windows.explorer.apply_tweaks }}

$ErrorActionPreference = 'Continue'

if ($env:CI -or $env:NREDF_NO_BOOTSTRAP) {
    exit 0
}

Write-Host "==> Applying Windows File Explorer developer tweaks..."

$advancedKey = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced"
$tweaks = [ordered]@{
    HideFileExt    = 0 # 1. Always show file extensions
    Hidden         = 1 # 2. Show hidden files
    LaunchTo       = 1 # 3. Launch File Explorer to "This PC"
    UseCompactMode = 1 # 4. Compact mode in Windows 11 Explorer
}

# Each write is checked: this used to print "applied successfully" even when every
# Set-ItemProperty had failed.
$failed = 0
try {
    if (-not (Test-Path $advancedKey)) {
        New-Item -Path $advancedKey -Force -ErrorAction Stop | Out-Null
    }
    foreach ($name in $tweaks.Keys) {
        try {
            Set-ItemProperty -Path $advancedKey -Name $name -Value $tweaks[$name] -Type DWord -ErrorAction Stop
        } catch {
            Write-Warning "Could not set Explorer setting ${name}: $_"
            $failed++
        }
    }
} catch {
    Write-Warning "Could not open ${advancedKey}: $_"
    $failed = $tweaks.Count
}

if ($failed -eq 0) {
    Write-Host "    File Explorer tweaks applied successfully (sign out or restart Explorer to see them)." -ForegroundColor Green
} else {
    Write-Warning "$failed of $($tweaks.Count) File Explorer tweaks failed."
}
exit 0
{{- end }}
