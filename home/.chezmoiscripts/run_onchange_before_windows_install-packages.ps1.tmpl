{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_before — installs prerequisite packages on Windows via winget.
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

$ErrorActionPreference = 'SilentlyContinue'

# Skip in CI or when the user explicitly opts out.
if ($env:CI -or $env:NREDF_NO_BOOTSTRAP) {
    exit 0
}

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "==> Warning: winget is not available on this system. Skipping OS package installation."
    exit 0
}

Write-Host "==> Installing prerequisite packages via winget"
$packages = @(
{{ range .packages.windows.winget -}}
    {{ . | quote }}
{{ end -}}
)

foreach ($pkg in $packages) {
    if (-not $pkg) { continue }
    Write-Host "    Ensuring winget package: $pkg"
    & winget install --id $pkg --exact --silent --accept-source-agreements --accept-package-agreements
}

# Configure Yazi's required 'file' MIME-type detector on Windows (shipped with Git for Windows)
$yaziFileCandidates = @(
    $env:YAZI_FILE_ONE
    (Join-Path $env:ProgramFiles "Git\usr\bin\file.exe")
    (Join-Path ${env:ProgramFiles(x86)} "Git\usr\bin\file.exe")
    (Join-Path $env:LOCALAPPDATA "Programs\Git\usr\bin\file.exe")
    "C:\Program Files\Git\usr\bin\file.exe"
)
if (Get-Command git -ErrorAction SilentlyContinue) {
    try {
        $gitDir = Split-Path (Split-Path (Get-Command git).Source)
        $yaziFileCandidates += (Join-Path $gitDir "usr\bin\file.exe")
    } catch {}
}
foreach ($candidate in $yaziFileCandidates) {
    if ($candidate -and (Test-Path $candidate)) {
        $env:YAZI_FILE_ONE = $candidate
        [System.Environment]::SetEnvironmentVariable("YAZI_FILE_ONE", $candidate, [System.EnvironmentVariableTarget]::User)
        Write-Host "    Configured YAZI_FILE_ONE: $candidate"
        break
    }
}

Write-Host "==> Windows prerequisites installed successfully."
{{- end }}
