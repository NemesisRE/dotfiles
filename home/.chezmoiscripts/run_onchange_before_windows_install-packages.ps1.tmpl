{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_before — installs prerequisite packages on Windows via winget.
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

# Was 'SilentlyContinue', which hid every failure. A before-hook must still never
# abort the apply, so failures are warned about and the script always exits 0.
$ErrorActionPreference = 'Continue'

# Skip in CI or when the user explicitly opts out.
if ($env:CI -or $env:NREDF_NO_BOOTSTRAP) {
    exit 0
}

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning "winget is not available on this system. Skipping OS package installation."
    exit 0
}

# winget exits non-zero when there is simply nothing to do. Codes from
# https://github.com/microsoft/winget-cli/blob/master/doc/windows/package-manager/winget/returnCodes.md
$wingetNothingToDo = @(
    -1978335189 # 0x8A15002B APPINSTALLER_CLI_ERROR_UPDATE_NOT_APPLICABLE
    -1978335135 # 0x8A150061 APPINSTALLER_CLI_ERROR_PACKAGE_ALREADY_INSTALLED
    -1978334963 # 0x8A15010D APPINSTALLER_CLI_ERROR_INSTALL_ALREADY_INSTALLED
    -1978335095 # 0x8A150089 APPINSTALLER_CLI_ERROR_FONT_ALREADY_INSTALLED
)
$wingetRebootToFinish = -1978334967 # 0x8A150109 APPINSTALLER_CLI_ERROR_INSTALL_REBOOT_REQUIRED_TO_FINISH

Write-Host "==> Installing prerequisite packages via winget"
$packages = @(
{{ range .packages.windows.winget -}}
    {{ . | quote }}
{{ end -}}
)

$failed = @()
foreach ($pkg in $packages) {
    if (-not $pkg) { continue }
    Write-Host "    Ensuring winget package: $pkg"
    & winget install --id $pkg --exact --silent --accept-source-agreements --accept-package-agreements
    $code = $LASTEXITCODE
    if ($code -eq 0 -or $wingetNothingToDo -contains $code) {
        continue
    }
    if ($code -eq $wingetRebootToFinish) {
        Write-Host "    $pkg installed; restart Windows to finish the installation." -ForegroundColor Yellow
        continue
    }
    Write-Warning ("winget install {0} failed with exit code {1} (0x{1:X8})." -f $pkg, $code)
    $failed += $pkg
}

if ($failed.Count -eq 0) {
    Write-Host "==> Windows prerequisites installed successfully."
} else {
    Write-Warning "Some winget packages failed to install: $($failed -join ', '). Continuing with the apply."
}
exit 0
{{- end }}
