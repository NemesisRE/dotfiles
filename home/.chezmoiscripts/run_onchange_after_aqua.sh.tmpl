{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_after hook — links aqua managed tools when aqua's config changes.
# aqua.yaml hash: {{ include "dot_config/aquaproj-aqua/aqua.yaml" | sha256sum }}
# registry.yaml hash: {{ include "dot_config/aquaproj-aqua/registry.yaml" | sha256sum }}
# aqua-policy.yaml hash: {{ include "dot_config/aquaproj-aqua/aqua-policy.yaml" | sha256sum }}
# aqua present at render time: {{ includeTemplate "hook-tool-present.tmpl" (dict "tool" "aqua" "chezmoi" .chezmoi) }}
# (re-runs this hook once aqua appears; see .chezmoitemplates/hook-tool-present.tmpl)

set -euo pipefail

[[ -n "${CI:-}" ]] && exit 0
[[ -n "${NREDF_NO_BOOTSTRAP:-}" ]] && exit 0

{{ template "hook-env.sh" . }}
# Vault-derived (chezmoi-managed) first, then the runtime-local one
# (nredf_aqua_token_setup's --env mode) so it can override.
AQUA_TOKEN_DIR="${NREDF_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/nredf}"
[[ -f "${AQUA_TOKEN_DIR}/aqua-vault.env" ]] && source "${AQUA_TOKEN_DIR}/aqua-vault.env"
[[ -f "${AQUA_TOKEN_DIR}/aqua.env" ]] && source "${AQUA_TOKEN_DIR}/aqua.env"

if command -v aqua >/dev/null 2>&1; then
  echo "==> Linking aqua managed tools"
  if out="$(aqua install -a -l 2>&1)"; then
    echo "    Aqua tools linked successfully."
  else
    echo "==> Warning: aqua install failed (rate limit? checksum mismatch? offline?); tools may be missing or stale:" >&2
    echo "${out}" >&2
  fi
else
  echo "==> Warning: aqua not found; managed tools were not linked" >&2
fi

# Ensure standalone Python via uv
if command -v uv >/dev/null 2>&1; then
  echo "==> Ensuring standalone Python via uv"
  uv python install --default >/dev/null 2>&1 || uv python install >/dev/null 2>&1 || true
fi
{{- end }}
