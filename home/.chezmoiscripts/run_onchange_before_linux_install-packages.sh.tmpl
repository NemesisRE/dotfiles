{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_before — installs prerequisite packages on Linux.
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

# Skip in CI or when the user explicitly opts out.
[[ -n "${CI:-}" ]] && exit 0
[[ -n "${NREDF_NO_BOOTSTRAP:-}" ]] && exit 0

can_sudo() {
  command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null || [[ "$(id -u)" -eq 0 ]] || [[ -t 0 ]]
}

if command -v apt-get >/dev/null 2>&1; then
  echo "==> Checking Debian/Ubuntu prerequisite packages"
  MISSING=()
  for pkg in {{ range .packages.linux.apt }}{{ . | quote }} {{ end }}; do
    if ! dpkg -s "${pkg}" >/dev/null 2>&1; then
      MISSING+=("${pkg}")
    fi
  done

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    if can_sudo; then
      echo "==> Installing missing apt packages: ${MISSING[*]}"
      SUDO=""
      [[ "$(id -u)" -ne 0 ]] && SUDO="sudo"
      ${SUDO} apt-get update -qq
      ${SUDO} apt-get install -y -qq "${MISSING[@]}"
    else
      echo "==> Warning: Sudo not available non-interactively; skipping: ${MISSING[*]}"
    fi
  else
    echo "    All apt prerequisite packages already installed."
  fi

elif command -v pacman >/dev/null 2>&1; then
  echo "==> Checking Arch Linux prerequisite packages"
  MISSING=()
  for pkg in {{ range .packages.linux.pacman }}{{ . | quote }} {{ end }}; do
    if ! pacman -Q "${pkg}" >/dev/null 2>&1; then
      MISSING+=("${pkg}")
    fi
  done

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    if can_sudo; then
      echo "==> Installing missing pacman packages: ${MISSING[*]}"
      SUDO=""
      [[ "$(id -u)" -ne 0 ]] && SUDO="sudo"
      ${SUDO} pacman -S --needed --noconfirm "${MISSING[@]}"
    else
      echo "==> Warning: Sudo not available non-interactively; skipping: ${MISSING[*]}"
    fi
  else
    echo "    All pacman prerequisite packages already installed."
  fi

elif command -v dnf >/dev/null 2>&1; then
  echo "==> Checking Fedora/RHEL prerequisite packages"
  MISSING=()
  for pkg in {{ range .packages.linux.dnf }}{{ . | quote }} {{ end }}; do
    if ! rpm -q "${pkg}" >/dev/null 2>&1; then
      MISSING+=("${pkg}")
    fi
  done

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    if can_sudo; then
      echo "==> Installing missing dnf packages: ${MISSING[*]}"
      SUDO=""
      [[ "$(id -u)" -ne 0 ]] && SUDO="sudo"
      ${SUDO} dnf install -y "${MISSING[@]}"
    else
      echo "==> Warning: Sudo not available non-interactively; skipping: ${MISSING[*]}"
    fi
  else
    echo "    All dnf prerequisite packages already installed."
  fi
fi

echo "==> Linux prerequisites check done."
{{- end }}
