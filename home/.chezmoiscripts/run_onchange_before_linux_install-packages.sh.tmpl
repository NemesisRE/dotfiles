{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# chezmoi run_onchange_before — installs prerequisite packages on Linux.
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

# Skip in CI or when the user explicitly opts out.
[[ -n "${CI:-}" ]] && exit 0
[[ -n "${NREDF_NO_BOOTSTRAP:-}" ]] && exit 0

# This is a `before` script, so a non-zero exit aborts `chezmoi apply` before a
# single dotfile is written. A package-manager hiccup (no network, no sudo, a
# cancelled password prompt) must therefore degrade to a warning, not an abort.
WARNINGS=0
warn() {
  echo "==> Warning: $*" >&2
  WARNINGS=$((WARNINGS + 1))
}

# Root can always install. Otherwise we need a sudo binary AND either a
# non-interactive grant or a TTY to type a password on. The previous one-liner
# parsed as `(sudo && sudo -n) || root || tty`, so on a host with no sudo at all
# a TTY alone made it return true and the later `sudo ...` killed the script.
can_sudo() {
  [[ "$(id -u)" -eq 0 ]] && return 0
  command -v sudo >/dev/null 2>&1 || return 1
  sudo -n true 2>/dev/null || [[ -t 0 ]]
}

if command -v apt-get >/dev/null 2>&1; then
  echo "==> Checking Debian/Ubuntu prerequisite packages"
  MISSING=()
  for pkg in {{ range .packages.linux.apt }}{{ . | quote }} {{ end }}; do
    if ! dpkg -s "${pkg}" >/dev/null 2>&1; then
      MISSING+=("${pkg}")
    fi
  done

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    if can_sudo; then
      echo "==> Installing missing apt packages: ${MISSING[*]}"
      SUDO=""
      [[ "$(id -u)" -ne 0 ]] && SUDO="sudo"
      if ! { ${SUDO} apt-get update -qq && ${SUDO} apt-get install -y -qq "${MISSING[@]}"; }; then
        warn "apt install failed; continuing without: ${MISSING[*]}"
      fi
    else
      warn "sudo not usable here; skipping apt packages: ${MISSING[*]}"
    fi
  else
    echo "    All apt prerequisite packages already installed."
  fi

elif command -v pacman >/dev/null 2>&1; then
  echo "==> Checking Arch Linux prerequisite packages"
  MISSING=()
  for pkg in {{ range .packages.linux.pacman }}{{ . | quote }} {{ end }}; do
    if ! pacman -Q "${pkg}" >/dev/null 2>&1; then
      MISSING+=("${pkg}")
    fi
  done

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    if can_sudo; then
      echo "==> Installing missing pacman packages: ${MISSING[*]}"
      SUDO=""
      [[ "$(id -u)" -ne 0 ]] && SUDO="sudo"
      if ! ${SUDO} pacman -S --needed --noconfirm "${MISSING[@]}"; then
        warn "pacman install failed; continuing without: ${MISSING[*]}"
      fi
    else
      warn "sudo not usable here; skipping pacman packages: ${MISSING[*]}"
    fi
  else
    echo "    All pacman prerequisite packages already installed."
  fi

elif command -v dnf >/dev/null 2>&1; then
  echo "==> Checking Fedora/RHEL prerequisite packages"
  MISSING=()
  for pkg in {{ range .packages.linux.dnf }}{{ . | quote }} {{ end }}; do
    if ! rpm -q "${pkg}" >/dev/null 2>&1; then
      MISSING+=("${pkg}")
    fi
  done

  if [[ ${#MISSING[@]} -gt 0 ]]; then
    if can_sudo; then
      echo "==> Installing missing dnf packages: ${MISSING[*]}"
      SUDO=""
      [[ "$(id -u)" -ne 0 ]] && SUDO="sudo"
      if ! ${SUDO} dnf install -y "${MISSING[@]}"; then
        warn "dnf install failed; continuing without: ${MISSING[*]}"
      fi
    else
      warn "sudo not usable here; skipping dnf packages: ${MISSING[*]}"
    fi
  else
    echo "    All dnf prerequisite packages already installed."
  fi
fi

if (( WARNINGS > 0 )); then
  echo "==> Linux prerequisites check finished with ${WARNINGS} warning(s); see above."
else
  echo "==> Linux prerequisites check done."
fi
{{- end }}
