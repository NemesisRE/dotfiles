{{- if eq .chezmoi.os "windows" -}}
# chezmoi run_onchange_after Windows hook — yazi environment and plugins.
# package.toml hash: {{ include "dot_config/yazi/package.toml.tmpl" | sha256sum }}
# The yazi/HOME environment setup is inlined from .chezmoitemplates/yazi-env.ps1, so
# a change there changes this script's text and re-runs it as well.

$ErrorActionPreference = 'Continue'

if ($env:CI -or $env:NREDF_NO_BOOTSTRAP) {
    exit 0
}

{{ includeTemplate "hook-env.ps1" . }}
{{ includeTemplate "yazi-env.ps1" . }}
if (Get-Command ya -ErrorAction SilentlyContinue) {
    $yaOutput = & ya pkg install --discard 2>&1 | Out-String
    if ($LASTEXITCODE -ne 0) {
        Write-Warning "ya pkg install failed (exit code $LASTEXITCODE); yazi plugins may be missing or stale:"
        Write-Warning $yaOutput
    }
}
exit 0
{{- end }}
