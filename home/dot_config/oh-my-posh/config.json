{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": false,
  "upgrade": {
    "notice": false,
    "auto": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "terminal_background": "#282C34",
  "transient_prompt": {
    "type": "text",
    "style": "plain",
    "foreground": "2",
    "foreground_templates": [
      "{{ if gt .Code 0 }}1{{ end }}"
    ],
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "8",
    "template": "  ❯ "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "8",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "powerline",
          "foreground": "0",
          "background": "7",
          "template": " {{ .Icon }} "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "15",
          "background": "1",
          "template": "  "
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "0",
          "background": "6",
          "template": "{{ if or .Env.SSH_CONNECTION .Env.SSH_CLIENT }}  {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "15",
          "background": "8",
          "template": " {{ .Name }} ",
          "options": {
            "mapped_shell_names": {
              "bash": "",
              "cmd": "",
              "fish": "󰈺",
              "nu": "󰑣",
              "powershell": "󰨊",
              "pwsh": "󰨊",
              "sh": "",
              "shell": "",
              "zsh": "󰞷"
            }
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "254",
          "background": "4",
          "template": "  {{ .Path }} ",
          "options": {
            "style": "full",
            "max_depth": 10
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "0",
          "background": "2",
          "background_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}3{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}{{ if gt .Working.Unmerged 0 }} ~{{ .Working.Unmerged }}{{ end }}{{ $staged := add .Staging.Added .Staging.Modified .Staging.Deleted }}{{ if gt $staged 0 }} +{{ $staged }}{{ end }}{{ $unstaged := add .Working.Added .Working.Modified }}{{ if gt $unstaged 0 }} !{{ $unstaged }}{{ end }}{{ if gt .Working.Deleted 0 }} ✘{{ .Working.Deleted }}{{ end }}{{ if gt .Working.Untracked 0 }} ?{{ .Working.Untracked }}{{ end }} ",
          "options": {
            "branch_icon": "  ",
            "ignore_submodules": {
              "*": "dirty"
            }
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "filler": "{{ if .Overflow }} {{ else }}<8>{{ repeat .Padding \"─\" }}</>{{ end }}",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "2",
          "foreground_templates": [
            "{{ if .Error }}3{{ end }}"
          ],
          "background": "0",
          "background_templates": [
            "{{ if .Error }}1{{ end }}"
          ],
          "template": " {{ if eq .Code 0 }}✔{{ else }}{{ .Code }} ✘{{ end }} ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "3",
          "template": " 󱎫 {{ .FormattedMs }} ",
          "options": {
            "threshold": 3000,
            "style": "austin"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "2",
          "template": "  {{ .Full }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "4",
          "template": "  {{ .Full }} ",
          "cache": {
            "duration": "1h",
            "strategy": "folder"
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "4",
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "options": {
            "display_mode": "context"
          }
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "208",
          "template": "  {{ .Full }} ",
          "cache": {
            "duration": "1h",
            "strategy": "folder"
          }
        },
        {
          "type": "terraform",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "4",
          "background": "0",
          "template": " 󱁢 {{ .WorkspaceName }} "
        },
        {
          "type": "helm",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "4",
          "template": " 󰠳 {{ .Version }} ",
          "options": {
            "display_mode": "files"
          },
          "cache": {
            "duration": "1h",
            "strategy": "folder"
          }
        },
        {
          "type": "docker",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "",
          "foreground": "0",
          "background": "6",
          "template": "{{ if not (or (eq .Context \"default\") (eq .Context \"desktop-linux\") (eq .Context \"colima\") (eq .Context \"orbstack\") (eq .Context \"rootless\")) }}  {{ .Context }} {{ end }}"
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "0",
          "background": "7",
          "template": "<background,parentBackground></> {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "8",
          "template": "╰─"
        },
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "7",
          "background": "5",
          "template": " 󱃾 {{ if and .Cluster (ne .Cluster .Context) }}{{ .Cluster }} :: {{ end }}{{ .Context }}/{{if .Namespace}}{{.Namespace}}{{else}}default{{end}} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "2",
          "foreground_templates": [
            "{{ if gt .Code 0 }}1{{ end }}"
          ],
          "template": "❯ "
        }
      ]
    }
  ],
  "tooltips": [
    {
      "type": "git",
      "tips": [
        "git",
        "lg",
        "lzg",
        "lazygit"
      ],
      "style": "powerline",
      "powerline_symbol": "",
      "leading_powerline_symbol": "",
      "foreground": "0",
      "background": "7",
      "template": " {{ if .Upstream }} {{ .Upstream }} {{ end }} {{ .Commit.Sha | trunc 7 }} {{ .Commit.Subject | trunc 48 }} "
    }
  ]
}
