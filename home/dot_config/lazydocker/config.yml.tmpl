# OneDark-Pro theme for lazydocker matching terminal theme — managed by chezmoi
# https://github.com/jesseduffield/lazydocker

gui:
  scrollHeight: 2
  scrollPastBottom: true
  sidePanelWidth: 0.3333
  theme:
    activeBorderColor:
      - "#61afef"
      - bold
    inactiveBorderColor:
      - "#4f5666"
    selectedLineBgColor:
      - "#3e4452"
    selectedRangeBgColor:
      - "#3e4452"
    optionsTextColor:
      - "#61afef"

reporting: "off"
confirmOnQuit: false

