[Unit]
Description=NREDF Daily Maintenance Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
# A oneshot has no start timeout by default, so a hung brew/chezmoi/aqua call
# would block every later run. Matches the Windows task's 2h ExecutionTimeLimit.
TimeoutStartSec=2h
ExecStart={{ .chezmoi.homeDir }}/.local/bin/nredf-daily-sync
