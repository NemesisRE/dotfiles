# OneDarkPro theme for Yazi — managed by chezmoi
# Aligned with terminal OneDarkPro, lazygit, AstroNvim, and oh-my-posh

[mgr]
cwd = { fg = "#56b6c2" }
syntect_theme = "{{ .chezmoi.homeDir }}/.config/yazi/OneDarkPro.tmTheme"

# Find
find_keyword  = { fg = "#e5c07b", bold = true, italic = true, underline = true }
find_position = { fg = "#c678dd", bg = "reset", bold = true, italic = true }

# Symlink
symlink_target = { fg = "#56b6c2", italic = true }

# Marker
marker_copied   = { fg = "#abb2bf", bg = "#98c379" }
marker_cut      = { fg = "#abb2bf", bg = "#e06c75" }
marker_marked   = { fg = "#abb2bf", bg = "#56b6c2" }
marker_selected = { fg = "#abb2bf", bg = "#e5c07b" }

# Count
count_copied   = { fg = "#98c379", bg = "#282c34" }
count_cut      = { fg = "#e06c75", bg = "#282c34" }
count_selected = { fg = "#e5c07b", bg = "#282c34" }

# Border
border_symbol = "│"
border_style  = { fg = "#4f5666" }

[tabs]
active   = { bg = "#61afef", fg = "#282c34", bold = true }
inactive = { fg = "#abb2bf", bg = "#3e4452" }

[mode]
normal_main = { fg = "#282c34", bg = "#61afef", bold = true }
normal_alt  = { fg = "#61afef", bg = "#3e4452", bold = true }
select_main = { fg = "#282c34", bg = "#98c379", bold = true }
select_alt  = { fg = "#98c379", bg = "#3e4452", bold = true }
unset_main  = { fg = "#282c34", bg = "#e06c75", bold = true }
unset_alt   = { fg = "#e06c75", bg = "#3e4452", bold = true }

[indicator]
current = { bg = "#3e4452" }
preview = { underline = true }

[status]
overall = {}
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

# Permissions
perm_sep   = { fg = "#5c6370" }
perm_type  = { fg = "#61afef" }
perm_read  = { fg = "#e06c75" }
perm_write = { fg = "#e5c07b" }
perm_exec  = { fg = "#98c379" }

# Progress
progress_label  = { fg = "#abb2bf", bold = true }
progress_normal = { fg = "#98c379", bg = "#282c34" }
progress_error  = { fg = "#e06c75", bg = "#282c34" }

[which]
mask            = { bg = "#282c34" }
cand            = { fg = "#98c379" }
rest            = { fg = "#abb2bf" }
desc            = { fg = "#e5c07b" }
separator       = "  "
separator_style = { fg = "#5c6370" }

[confirm]
border = { fg = "#61afef" }
title  = { fg = "#61afef" }

[spot]
border   = { fg = "#61afef" }
title    = { fg = "#61afef" }
tbl_col  = { fg = "#61afef" }
tbl_cell = { fg = "#e5c07b", reversed = true }

[notify]
title_info  = { fg = "#98c379" }
title_warn  = { fg = "#e5c07b" }
title_error = { fg = "#e06c75" }

[pick]
border   = { fg = "#61afef" }
active   = { fg = "#c678dd", bold = true }
inactive = {}

[input]
border = { fg = "#61afef" }

[cmp]
border = { fg = "#61afef" }

[tasks]
border  = { fg = "#61afef" }
hovered = { fg = "#c678dd", underline = true }

[help]
on      = { fg = "#98c379" }
run     = { fg = "#e5c07b" }
hovered = { reversed = true, bold = true }
footer  = { fg = "#abb2bf", bg = "#282c34" }

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "#e5c07b" },

	# Media
	{ mime = "{audio,video}/*", fg = "#e06c75" },

	# Archives
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#c678dd" },

	# Documents
	{ mime = "application/{pdf,doc,rtf,vnd.*}", fg = "#98c379" },

	# Code
	{ mime = "application/{json,ndjson,javascript,wine-extension-ini}", fg = "#56b6c2" },

	# Fallback
	{ url = "*", fg = "#abb2bf" },
	{ url = "*/", fg = "#61afef", bold = true },
]
