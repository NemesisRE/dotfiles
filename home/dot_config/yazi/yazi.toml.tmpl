[mgr]
show_hidden = true
show_symlink = true

[opener]
edit = [
	{ run = 'nvim %s', block = true, desc = "Neovim" },
]

[open]
prepend_rules = [
	# Dotfiles (e.g. .bashrc, .zshrc, .gitconfig, .profile)
	{ url = ".*", use = "edit" },
	# Text, scripts, configs, and source files
	{ url = "*.{txt,md,json,yaml,yml,toml,ini,conf,cfg,sh,bash,zsh,ps1,psm1,psd1,lua,py,js,ts,go,rs,k8s,tmpl}", use = "edit" },
	{ mime = "text/*", use = "edit" },
	{ mime = "application/{json,ndjson,javascript,x-javascript,x-sh,x-csh,x-shellscript,xml,toml,yaml,x-yaml}", use = "edit" },
	{ mime = "inode/{empty,x-empty}", use = "edit" },
]

[preview]
tab_size = 2

[plugin]
prepend_fetchers = [
	{ url = "*", run = "git", group = "git" },
	{ url = "*/", run = "git", group = "git" },
	# mime-ext: extension-database MIME lookup instead of spawning file(1) per
	# file (a big win on Windows, where file.exe comes from Git for Windows).
	# init.lua enables fallback_file1 so unknown extensions still use file(1).
	{ url = "local://*", run = "mime-ext.local", prio = "high", group = "mime" },
	{ url = "remote://*", run = "mime-ext.remote", prio = "high", group = "mime" },
]
prepend_previewers = [
	# Archive previewer
	{ mime = "application/*zip",           run = "ouch" },
	{ mime = "application/tar",            run = "ouch" },
	{ mime = "application/bzip2",          run = "ouch" },
	{ mime = "application/7z-compressed",  run = "ouch" },
	{ mime = "application/rar",            run = "ouch" },
	{ mime = "application/xz",             run = "ouch" },
	# glow.yml sets pager: true for interactive use, and glow 3.0 ignores
	# --pager=false once that's on; PAGER=cat makes glow's own pager a no-op
	# instead, so this preview still prints straight to yazi's preview pane.
	{ mime = "text/markdown", run = 'piper -- PAGER=cat CLICOLOR_FORCE=1 glow -w=$w -s=dark "$1"' },
]
