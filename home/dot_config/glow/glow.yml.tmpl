# Glow markdown viewer configuration — managed by chezmoi
# https://github.com/charmbracelet/glow

# Style name or path: "dark", "light", "auto"
style: "dark"

# Show all files, including hidden and ignored ones (TUI mode only)
all: false

# Mouse support in pager
mouse: true

# Use pager to display markdown. yazi's markdown previewer runs glow with
# PAGER=cat so this does not affect its preview pane (glow 3.0 cannot turn
# the pager back off with --pager=false once this is true).
pager: true

# Word-wrap at specified number of columns
width: 100
