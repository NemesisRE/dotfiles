# Glow markdown viewer configuration — managed by chezmoi
# https://github.com/charmbracelet/glow

# Style name or path: "dark", "light", "auto"
style: "dark"

# Show all files including non-markdown
showAllFiles: false

# Mouse support in pager
mouse: true

# Use pager to display markdown
pager: true

# Word-wrap at specified number of columns
width: 100

