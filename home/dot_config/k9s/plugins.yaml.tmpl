plugins:
  approve-csr:
    shortCut: a
    confirm: true
    description: Approve a csr
    scopes:
      - csr
{{- if eq .chezmoi.os "windows" }}
    command: powershell
    background: false
    args:
      - -NoProfile
      - -Command
      - "kubectl certificate approve --context $env:CONTEXT $env:NAME"
{{- else }}
    command: sh
    background: false
    args:
      - -c
      - "kubectl certificate approve --context $CONTEXT $NAME"
{{- end }}

  veleroBackupLogs:
    shortCut: l
    confirm: false
    description: Velero backup logs
    scopes:
    - backup
    - backups
    - velero.io/v1/backups
{{- if eq .chezmoi.os "windows" }}
    command: powershell
    background: false
    args:
    - -NoProfile
    - -Command
    - "velero backup logs $env:NAME --kubecontext $env:CONTEXT | Out-Host -Paging"
{{- else }}
    command: sh
    background: false
    args:
    - -c
    - "velero backup logs $NAME --kubecontext $CONTEXT | less -K"
{{- end }}

  veleroBackupDescribe:
    shortCut: Ctrl-L
    confirm: false
    description: Velero describe backup
    scopes:
    - backup
    - backups
    - velero.io/v1/backups
{{- if eq .chezmoi.os "windows" }}
    command: powershell
    background: false
    args:
    - -NoProfile
    - -Command
    - "velero backup describe $env:NAME --kubecontext $env:CONTEXT | Out-Host -Paging"
{{- else }}
    command: sh
    background: false
    args:
    - -c
    - "velero backup describe $NAME --kubecontext $CONTEXT | less -K"
{{- end }}
