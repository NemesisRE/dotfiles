# chezmoi-managed thin nu entry-point stub (Linux) — the real logic lives in
# ~/.local/share/nredf/shell/nushell/env.nu (one canonical tree for every OS, like
# ~/.local/share/nredf/shell/pwsh is for PowerShell), because nu's own default config directory
# differs per OS (~/.config/nushell on Linux, ~/Library/Application
# Support/nushell on macOS, %APPDATA%\nushell on Windows) and is resolved
# from the real process environment before nu reads any of its own files, so
# the usual "set XDG_CONFIG_HOME lazily in shell startup code" trick this
# repo uses elsewhere never reaches nu at all. See AGENTS.md and
# docs/shells.md.

source "{{ .chezmoi.homeDir }}/.local/share/nredf/shell/nushell/env.nu"
