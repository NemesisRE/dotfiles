layout {
  default_tab_template {
    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
  }

{{- if lookPath "btm" }}

  tab name="Monitor" focus=true split_direction="horizontal" {
    pane command="btm" size="40%" borderless=true {
      args "-C" "~/.config/bottom/layout-cpu-proc.toml"
    }
    pane split_direction="vertical" {
      pane name="Term" focus=true
      pane command="btm" size="25%" borderless=true {
        args "-C" "~/.config/bottom/layout-mem-disk-net.toml"
      }
    }
  }

  tab
{{- else }}

  tab focus=true
{{- end }}
}
