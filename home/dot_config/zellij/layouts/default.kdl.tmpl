{{- /*
btop only comes from aqua on Linux (no macOS/Windows release asset), so each
monitor pane runs btop when it is on PATH and otherwise drops to a normal shell
instead of leaving a dead "command not found" pane.
*/ -}}
{{- define "zellij-btop-pane-args" -}}
{{-   if eq .os "windows" -}}
args "-NoLogo" "-NoExit" "-Command" "if (Get-Command btop -ErrorAction SilentlyContinue) { btop -p {{ .preset }}; exit }"
{{-   else -}}
args "-c" "command -v btop >/dev/null 2>&1 && exec btop -p {{ .preset }}; exec \"${SHELL:-/bin/sh}\""
{{-   end -}}
{{- end -}}
{{- $shell := "sh" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $shell = "pwsh" -}}
{{- end -}}
layout {
  default_tab_template {
    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
  }

  tab name="Monitor" focus=true split_direction="horizontal" {
    pane command="{{ $shell }}" size="40%" borderless=true {
      {{ template "zellij-btop-pane-args" dict "os" .chezmoi.os "preset" "1" }}
    }
    pane split_direction="vertical" {
      pane name="Term" focus=true
      pane command="{{ $shell }}" size="25%" borderless=true {
        {{ template "zellij-btop-pane-args" dict "os" .chezmoi.os "preset" "2" }}
      }
    }
  }

  tab
}
