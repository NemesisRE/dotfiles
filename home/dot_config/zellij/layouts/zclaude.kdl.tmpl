layout {
  default_tab_template {
    pane size=2 borderless=true {
      plugin location="zellij:status-bar"
    }
    pane size=1 borderless=true {
      plugin location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zjstatus.wasm" {
        // Status and usage are pushed by the zclaude supervisor via `zellij pipe`
        // (zjstatus pipe widget). Do not use command_* widgets here: zjstatus spawns a
        // process per instance (one per tab) every interval and re-spawns on every render
        // while a result is still pending, which floods Windows with wsl.exe/bash.exe.
        format_left   "#[fg=#282C34,bg=#4AA5F0,bold] 󰚩 Claude #[fg=#4AA5F0,bg=#3F4451]{pipe_status}#[fg=#3F4451,bg=#282C34]"
        format_right  "#[fg=#3F4451,bg=#282C34]{pipe_usage}{datetime}#[fg=#4AA5F0,bg=#3F4451]#[fg=#282C34,bg=#4AA5F0,bold] zclaude "
        format_space  "#[bg=#282C34]"

        pipe_status_format      "#[fg=#ABB2BF,bg=#3F4451] {output} "
        pipe_status_rendermode  "static"

        pipe_usage_format       "#[fg=#ABB2BF,bg=#3F4451] {output} #[fg=#5c6370,bg=#3F4451]"
        pipe_usage_rendermode   "static"

        datetime          "#[fg=#ABB2BF,bg=#3F4451] {format} "
        datetime_format   "%H:%M"
        datetime_timezone "Europe/Berlin"
      }
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
  }

  tab name="Claude" focus=true {
    pane name="Claude Code" focus=true
  }

  tab name="Dev" split_direction="horizontal" {
    pane name="Editor" focus=true
    pane split_direction="vertical" size="40%" {
      pane name="Terminal"
{{- if lookPath "lazygit" }}
      pane name="Git" command="lazygit"
{{- else }}
      pane name="Git"
{{- end }}
    }
  }

{{- if lookPath "btm" }}

  tab name="Monitor" {
    pane command="btm" borderless=true
  }
{{- end }}

  swap_tiled_layout name="vertical-split" {
    tab max_panes=3 {
      pane focus=true size="72%"
      pane split_direction="horizontal" size="28%" {
        pane
        pane
      }
    }
  }

  swap_tiled_layout name="horizontal-split" {
    tab max_panes=3 {
      pane focus=true size="70%"
      pane split_direction="vertical" size="30%" {
        pane
        pane
      }
    }
  }

  swap_tiled_layout name="fullscreen" {
    tab max_panes=1 {
      pane focus=true
    }
  }
}
