{{- $token := includeTemplate "get-github-token.tmpl" . | trim -}}
{{- if $token -}}
# Generated by chezmoi — do not edit manually.
# `export` matters here: bash's plain `source` of an un-exported VAR=value
# assignment never reaches child processes (the aqua binary itself), unlike
# fish/nu's dotenv reader (nredf-read-dotenv) and PowerShell's parser, which
# both already strip a leading `export` and always export regardless.
export AQUA_GITHUB_TOKEN={{ $token | quote }}
export GITHUB_TOKEN={{ $token | quote }}
{{- end -}}

