# Generated by chezmoi — do not edit by hand.
# `git config --global` writes here and is reverted by the next `chezmoi apply`;
# put machine-local settings in ~/.config/git/config.local (included last).
{{- $name := .git.name }}
{{- $email := .git.email }}
{{- $signingKey := includeTemplate "get-signing-key.tmpl" . | trim }}
{{- $gpgFormat := .git.format | default "ssh" }}
{{- /* A literal SSH public key needs git's `key::` prefix (the bare form is
       deprecated); a path to a key file is passed through unchanged. */ -}}
{{- if and (eq $gpgFormat "ssh") (regexMatch "^(ssh-|ecdsa-|sk-ssh-|sk-ecdsa-)" $signingKey) }}
{{-   $signingKey = printf "key::%s" $signingKey }}
{{- end }}
[user]
{{- if $name }}
	name = "{{ $name }}"
{{- end }}
{{- if $email }}
	email = "{{ $email }}"
{{- end }}
{{- if $signingKey }}
	signingkey = "{{ $signingKey }}"
{{- end }}

[commit]
	gpgsign = {{ if $signingKey }}true{{ else }}false{{ end }}

{{- if $signingKey }}
{{- if $gpgFormat }}

[gpg]
	format = {{ $gpgFormat }}
{{- end }}
{{- if eq $gpgFormat "ssh" }}

[gpg "ssh"]
	# Lets `git log --show-signature` and `git verify-commit` trust our own key.
	allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}
{{- end }}

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	# Explicit so delta matches bat even when BAT_THEME is unset (IDEs, GUIs).
	syntax-theme = OneDarkPro
	navigate = true
	dark = true
	side-by-side = false
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[fetch]
	prune = true

[rerere]
	enabled = true

[init]
	defaultBranch = main

[push]
	default = simple
	followTags = true
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[tag]
	sort = version:refname

[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

[format]
	pretty = format:%C(blue)%ad%Creset %C(yellow)%h%C(green)%d%Creset %C(blue)%s %C(magenta) [%an]%Creset

[alias]
	# Basic Commands
	co = checkout
	ci = commit -m
	st = status --ignored=traditional --show-stash --short
	mt = mergetool
	df = difftool
	ba = branch
	baa = branch -a
	pr = pull --rebase
	cp = cherry-pick
	aa = add -A
	fa = fetch -p --all
	rc = rebase --continue
	pullsub = "!f(){ git submodule sync; git submodule update --init --remote --recursive; }; f"
	pullall = "!f(){ git pull \"$@\"; git submodule update --init --remote --recursive; }; f"
	gone = "!f() { git fetch --prune && git branch -vv | grep \": gone]\" | awk '{print $1}' | while read -r branch; do [ -n \"$branch\" ] && git branch -d \"$branch\"; done; }; f"
	# Productivity Shortcuts
	undo = reset --soft HEAD~1
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	discard = checkout --
	branches = branch -a --sort=-committerdate
	tags = tag -l --sort=-v:refname
	conflicts = diff --name-only --diff-filter=U
	wip = "!git add -A && git commit -m 'wip'"
	# Log aliases
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(cyan)- %an%Creset' --abbrev-commit --date=relative
	lstat = log --stat --relative --abbrev-commit --date=local --pretty=format:'%C(white)%h %C(cyan)%cr %C(green)by %cn %Creset%C(yellow)%n%s%Creset'

[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = manager
{{- else if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = cache --timeout=3600
{{- end }}

# Keep last so machine-local settings win over everything above. git silently
# skips a missing include file.
[include]
	path = ~/.config/git/config.local
