{{- /* Trust list for SSH-signed commits (gpg.ssh.allowedSignersFile in config.tmpl).
       Renders only for gpg.format = ssh with an email and a resolvable public key;
       an empty render means chezmoi does not deploy the file. */ -}}
{{- $email := .git.email | default "" -}}
{{- $gpgFormat := .git.format | default "ssh" -}}
{{- $key := includeTemplate "get-signing-key.tmpl" . | trim | trimPrefix "key::" -}}
{{- $publicKey := "" -}}
{{- if and $email $key (eq $gpgFormat "ssh") -}}
{{-   if regexMatch "^(ssh-|ecdsa-|sk-ssh-|sk-ecdsa-)" $key -}}
{{-     $publicKey = $key -}}
{{-   else -}}
{{- /* A key path: read only its .pub half, never a private key file. */ -}}
{{-     $path := $key -}}
{{-     if hasPrefix "~/" $path -}}
{{-       $path = joinPath .chezmoi.homeDir (trimPrefix "~/" $path) -}}
{{-     end -}}
{{-     if not (hasSuffix ".pub" $path) -}}
{{-       $path = printf "%s.pub" $path -}}
{{-     end -}}
{{-     if and (osIsAbs $path) (stat $path) -}}
{{-       $publicKey = include $path | trim -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if $publicKey -}}
# Generated by chezmoi — do not edit by hand.
{{ $email }} {{ $publicKey }}
{{ end -}}
