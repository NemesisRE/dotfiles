# Managed by chezmoi — do not edit by hand
# https://sheldon.cli.rs/Configuration.html

shell = "zsh"

# ── oh-my-zsh ─────────────────────────────────────────────────────────────────
# Load completion.zsh first, then other lib files, then plugins.
# This ensures compdef is available before plugins try to use it.
[plugins.ohmyzsh]
github = "ohmyzsh/ohmyzsh"
use = [
  "lib/completion.zsh",
  "lib/functions.zsh",
  "lib/history.zsh",
  "lib/misc.zsh",
  "lib/spectrum.zsh",
  "lib/termsupport.zsh",
  "lib/theme-and-appearance.zsh",
  "plugins/npm/npm.plugin.zsh",
  "plugins/extract/extract.plugin.zsh",
  "plugins/colored-man-pages/colored-man-pages.plugin.zsh",
  "plugins/cp/cp.plugin.zsh",
  "plugins/systemadmin/systemadmin.plugin.zsh",
]


[plugins.ohmyzsh.hooks]
# DISABLE_LS_COLORS=true: lib/theme-and-appearance.zsh (lazy-loaded on the
# first precmd, after nredf's own `ls`/`lsd` alias from common/aliases is
# already set) otherwise re-aliases `ls` with its own LS_COLORS/LSCOLORS.
pre  = 'DISABLE_AUTO_TITLE=true; HYPHEN_INSENSITIVE=true; DISABLE_AUTO_UPDATE=true; DISABLE_LS_COLORS=true; ENABLE_CORRECTION=false; HIST_STAMPS="dd.mm.yyyy"; ZSH_CUSTOM="${NREDF_RC_PATH:-${HOME}/.config/zsh}"; (( ${+functions[compdef]} )) || { autoload -Uz compinit; (( ${+functions[_nredf_compinit]} )) && _nredf_compinit -i || compinit -i; }'
post = '[[ -f "${HOME}/.config/fzf/key-bindings.zsh" ]] && source "${HOME}/.config/fzf/key-bindings.zsh"'

# ── fzf completions ───────────────────────────────────────────────────────────
[plugins.fzf-tab]
github = "Aloxaf/fzf-tab"

[plugins.fzf-zsh-completions]
github = "chitoku-k/fzf-zsh-completions"

[plugins.zsh-completions]
github = "zsh-users/zsh-completions"
apply = ["fpath"]

# ── utility plugins ───────────────────────────────────────────────────────────
[plugins.zsh-autopair]
github = "hlissner/zsh-autopair"

[plugins.calc]
github = "arzzen/calc.plugin.zsh"

# ── load last: these hook into ZLE and must come after other plugins ──────────
[plugins.zsh-autosuggestions]
github = "zsh-users/zsh-autosuggestions"

[plugins.fast-syntax-highlighting]
github = "zdharma-continuum/fast-syntax-highlighting"

