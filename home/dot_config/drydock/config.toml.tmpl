roots = [{{ .dev.projects | replace "~" .chezmoi.homeDir | quote }}]
max_depth = 4
follow_nested_repos = false
follow_symlinks = false
exclude = []
prune = []

[refresh]
interval = "5m"
watch = true
debounce = "1s"

[status]
untracked = "normal"
max_files = 200
max_age = "1h"

[remote]
fetch = false
interval = "1h"
concurrency = 4
timeout = "20s"

[visibility]
enabled = false
interval = "24h"
concurrency = 4
timeout = "10s"

[release]
tag_pattern = "*[0-9]*"
max_subjects = 30
read_changelog = true
changelog_files = [
    "CHANGELOG.md",
    "CHANGELOG",
    "changelog.md",
]

[ui]
default_filters = []
default_sort = "activity"
default_since = ""
{{- /*
The launch commands spawn a separate window, so a TUI app never fights drydock
for its terminal. There is no Windows branch here: drydock has no Windows
launch story (no winget/aqua asset gates it out today, and .chezmoiignore
should add one — see the PR body). kitty is installed on both macOS (Homebrew
cask) and Linux (kitty hook). On macOS `kitty --detach` is unsupported, so
start it through `open -na` instead (see `kitty --help`).
*/}}
{{- if eq .chezmoi.os "darwin" }}
editor_command = [
    "open", "-na", "kitty", "--args",
    "--directory", "{path}",
    "sh", "-c", "exec \"${EDITOR:-nvim}\" .",
]
git_client_command = [
    "open", "-na", "kitty", "--args",
    "--directory", "{path}",
    "lazygit",
]
terminal_command = [
    "open", "-na", "kitty", "--args",
    "--directory", "{path}",
]
file_manager_command = [
    "open",
    "{path}",
]
{{- else }}
editor_command = [
    "kitty", "--detach",
    "--directory", "{path}",
    "sh", "-c", "exec \"${EDITOR:-nvim}\" .",
]
git_client_command = [
    "kitty", "--detach",
    "--directory", "{path}",
    "lazygit",
]
terminal_command = [
    "kitty", "--detach",
    "--directory", "{path}",
]
file_manager_command = [
    "xdg-open",
    "{path}",
]
{{- end }}
