#
# vim: ts=4 sw=4 et ft=fish
#
# chezmoi-managed config.fish — sets required env and sources the nredf fish rc.
# No homesick/homeshick references. All paths are relative to $HOME.

set -gx XDG_CONFIG_HOME (test -n "$XDG_CONFIG_HOME"; and echo "$XDG_CONFIG_HOME"; or echo "$HOME/.config")
set -gx XDG_DATA_HOME (test -n "$XDG_DATA_HOME"; and echo "$XDG_DATA_HOME"; or echo "$HOME/.local/share")
set -gx SHELL (status fish-path)

set -gx NREDF_SHELL_NAME fish
set -gx NREDF_DOT_PATH (test -n "$NREDF_DOT_PATH"; and echo "$NREDF_DOT_PATH"; or echo "$XDG_DATA_HOME/nredf")
if not test -f "$NREDF_DOT_PATH/shell/fish/rc"; and test -f "$XDG_DATA_HOME/nredf/shell/fish/rc"
    set -gx NREDF_DOT_PATH "$XDG_DATA_HOME/nredf"
end
set -gx NREDF_RC_PATH "$NREDF_DOT_PATH/shell/fish"

if test -f "$NREDF_DOT_PATH/shell/fish/rc"
    source "$NREDF_DOT_PATH/shell/fish/rc"
end
