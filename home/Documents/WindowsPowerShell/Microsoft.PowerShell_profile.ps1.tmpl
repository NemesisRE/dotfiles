{{- if eq .chezmoi.os "windows" -}}
# Windows PowerShell 5.1 profile managed by chezmoi
# Dot-sources the unified configuration from Documents/PowerShell

$configProfile = Join-Path $HOME "Documents\PowerShell\Microsoft.PowerShell_profile.ps1"
if (-not (Test-Path $configProfile)) {
    $configProfile = Join-Path $HOME ".config\powershell\Microsoft.PowerShell_profile.ps1"
}
if (Test-Path $configProfile) {
    . $configProfile
}
{{- end }}
