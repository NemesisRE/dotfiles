# Settings apply across all WSL 2 distributions running on Windows.
# https://learn.microsoft.com/en-us/windows/wsl/wsl-config

[wsl2]
memory={{ if and (hasKey . "windows") (hasKey .windows "wsl") (hasKey .windows.wsl "memory") }}{{ .windows.wsl.memory }}{{ else }}16GB{{ end }}
processors={{ if and (hasKey . "windows") (hasKey .windows "wsl") (hasKey .windows.wsl "processors") }}{{ .windows.wsl.processors }}{{ else }}8{{ end }}
localhostForwarding=true
networkingMode={{ if and (hasKey . "windows") (hasKey .windows "wsl") (hasKey .windows.wsl "networking_mode") }}{{ .windows.wsl.networking_mode }}{{ else }}mirrored{{ end }}
autoProxy=true
dnsTunneling=true
firewall=true

[experimental]
autoMemoryReclaim=gradual
sparseVhd=true

