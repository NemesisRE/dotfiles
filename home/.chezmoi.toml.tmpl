{{- /* Native machine-local configuration prompted once via chezmoi init */ -}}
{{- $git := index . "git" | default dict -}}
{{- $dev := index . "dev" | default dict -}}
{{- $shell := index . "shell" | default dict -}}
{{- $ssh := index $shell "ssh" | default dict -}}
{{- $kitty := index . "kitty" | default dict -}}
{{- $secrets := index . "secrets" | default dict -}}

{{- $rawProfile := promptStringOnce $secrets "profile" "Secrets profile preset [personal, work, custom, none]" "personal" -}}
{{- $profile := "personal" -}}
{{- if regexMatch "^(?i:w|work)$" $rawProfile -}}
{{-   $profile = "work" -}}
{{- else if regexMatch "^(?i:c|custom)$" $rawProfile -}}
{{-   $profile = "custom" -}}
{{- else if regexMatch "^(?i:n|none|false|0)$" $rawProfile -}}
{{-   $profile = "none" -}}
{{- end -}}

{{- $defaultAquaToken := "" -}}
{{- $defaultGitSigningKey := "" -}}
{{- if eq $profile "personal" -}}
{{-   $defaultAquaToken = "bitwarden:GitHub - Personal" -}}
{{-   $defaultGitSigningKey = "bitwarden:SSH - Personal" -}}
{{- else if eq $profile "work" -}}
{{-   $defaultAquaToken = "bitwarden:GitHub - Personal" -}}
{{-   $defaultGitSigningKey = "keepassxc:Work/Git Signing Key" -}}
{{- end -}}

{{- $aquaToken := "" -}}
{{- $gitSigningKey := "" -}}
{{- $keepassDb := index $secrets "keepassxc_db" | default "" -}}

{{- if ne $profile "none" -}}
{{-   $aquaToken = promptStringOnce $secrets "aqua_github_token" "Aqua GitHub token URI or value" $defaultAquaToken -}}
{{-   $gitSigningKey = promptStringOnce $secrets "git_signing_key" "Git signing key URI or value" $defaultGitSigningKey -}}
{{-   if or (eq $profile "work") (hasPrefix "keepassxc:" $aquaToken) (hasPrefix "keepassxc:" $gitSigningKey) -}}
{{-     $keepassDb = promptStringOnce $secrets "keepassxc_db" "KeePassXC database path (e.g. ~/Documents/Work/work.kdbx)" "~/Documents/Work/work.kdbx" -}}
{{-   end -}}
{{- end -}}

{{- $name := promptStringOnce $git "name" "Git user name (user.name)" "Steven 'NemesisRE' Kurz" -}}
{{- $email := promptStringOnce $git "email" "Git email address (user.email)" "nemesissre@gmail.com" -}}
{{- $signingkeyPrompt := "Git signing key (SSH/GPG public key or path)" -}}
{{- if ne $gitSigningKey "" -}}
{{-   $signingkeyPrompt = "Git signing key (leave blank to resolve from secret store)" -}}
{{- end -}}
{{- $signingkey := promptStringOnce $git "signingkey" $signingkeyPrompt "" -}}

{{- $rawGitFormat := promptStringOnce $git "format" "Git commit signing format [ssh, openpgp]" "ssh" -}}
{{- $gitFormat := "ssh" -}}
{{- if regexMatch "^(?i:o|openpgp|gpg)$" $rawGitFormat -}}
{{-   $gitFormat = "openpgp" -}}
{{- end -}}

{{- $projects := promptStringOnce $dev "projects" "Projects directory" "~/Repos" -}}

{{- $rawMultiplexer := promptStringOnce $shell "multiplexer" "Enable remote multiplexer (attach zellij on remote login) [yes, no]" "yes" -}}
{{- $multiplexer := true -}}
{{- if regexMatch "^(?i:n|no|false|0)$" (print $rawMultiplexer) -}}
{{-   $multiplexer = false -}}
{{- end -}}

{{- $isWsl := false -}}
{{- if or (env "WSL_DISTRO_NAME") (env "WSL_INTEROP") (and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") (hasKey .chezmoi.kernel "osrelease") (.chezmoi.kernel.osrelease | regexMatch "(?i:microsoft|wsl)")) -}}
{{-   $isWsl = true -}}
{{- end -}}

{{- $rawWslMultiplexer := "no" -}}
{{- if or $isWsl (hasKey $shell "wsl_multiplexer") -}}
{{-   $rawWslMultiplexer = promptStringOnce $shell "wsl_multiplexer" "Enable multiplexer on WSL (attach zellij on WSL startup) [yes, no]" "no" -}}
{{- else -}}
{{-   $rawWslMultiplexer = index $shell "wsl_multiplexer" | default "no" -}}
{{- end -}}
{{- $wslMultiplexer := false -}}
{{- if regexMatch "^(?i:y|yes|true|1)$" (print $rawWslMultiplexer) -}}
{{-   $wslMultiplexer = true -}}
{{- end -}}

{{- $rawSshAgent := promptStringOnce $ssh "agent" "SSH agent provider [default, bitwarden, pipe, gpg]" "default" -}}
{{- $sshAgent := "default" -}}
{{- if regexMatch "^(?i:b|bitwarden)$" $rawSshAgent -}}
{{-   $sshAgent = "bitwarden" -}}
{{- else if regexMatch "^(?i:p|pipe)$" $rawSshAgent -}}
{{-   $sshAgent = "pipe" -}}
{{- else if regexMatch "^(?i:g|gpg|gnupg)$" $rawSshAgent -}}
{{-   $sshAgent = "gpg" -}}
{{- end -}}

{{- $rawKittyQuakeKey := promptStringOnce $kitty "quake_key" "Kitty Quake mode global shortcut key [F12, Pause, none]" "F12" -}}
{{- $kittyQuakeKey := $rawKittyQuakeKey -}}
{{- if regexMatch "^(?i:p|pause)$" $rawKittyQuakeKey -}}
{{-   $kittyQuakeKey = "Pause" -}}
{{- else if regexMatch "^(?i:n|none)$" $rawKittyQuakeKey -}}
{{-   $kittyQuakeKey = "none" -}}
{{- else if or (regexMatch "^(?i:f|f12)$" $rawKittyQuakeKey) (eq $rawKittyQuakeKey "") -}}
{{-   $kittyQuakeKey = "F12" -}}
{{- end -}}

{{- if and (hasKey .chezmoi "workingTree") (ne .chezmoi.workingTree (joinPath .chezmoi.homeDir ".local/share/chezmoi")) }}
sourceDir = {{ .chezmoi.workingTree | quote }}
{{- end }}

[data.git]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
    format = {{ $gitFormat | quote }}

[data.dev]
    projects = {{ $projects | quote }}

[data.shell]
    multiplexer = {{ $multiplexer }}
    wsl_multiplexer = {{ $wslMultiplexer }}

[data.shell.ssh]
    agent = {{ $sshAgent | quote }}

[data.kitty]
    quake_key = {{ $kittyQuakeKey | quote }}

[data.secrets]
    profile = {{ $profile | quote }}
    aqua_github_token = {{ $aquaToken | quote }}
    git_signing_key = {{ $gitSigningKey | quote }}
{{- if ne $keepassDb "" }}
    keepassxc_db = {{ $keepassDb | quote }}
{{- end }}

{{- $needBitwarden := or (hasPrefix "bitwarden:" $aquaToken) (hasPrefix "bw:" $aquaToken) (hasPrefix "bitwarden:" $gitSigningKey) (hasPrefix "bw:" $gitSigningKey) (eq $profile "personal") }}
{{- if $needBitwarden }}
[bitwarden]
    command = "bw"
    unlock = "auto"
{{- end }}

{{- $needKeepassxc := and (ne $keepassDb "") (or (hasPrefix "keepassxc:" $aquaToken) (hasPrefix "keepassxc:" $gitSigningKey) (eq $profile "work")) }}
{{- if $needKeepassxc }}
[keepassxc]
    command = "keepassxc-cli"
    database = {{ $keepassDb | quote }}
    prompt = true
{{- end }}

{{- $needOnepassword := or (hasPrefix "onepassword:" $aquaToken) (hasPrefix "op:" $aquaToken) (hasPrefix "onepassword:" $gitSigningKey) (hasPrefix "op:" $gitSigningKey) }}
{{- if $needOnepassword }}
[onepassword]
    command = "op"
    prompt = true
{{- end }}

