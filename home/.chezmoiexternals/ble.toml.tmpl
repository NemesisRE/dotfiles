{{- /* Rolling `nightly` build, pinned by the SHA-256 in .chezmoidata/ble.yaml. The URL
       never changes, so a new nightly is picked up only when that hash is bumped
       (chezmoi re-downloads when the checksum in the entry changes). */ -}}
{{- if ne .chezmoi.os "windows" }}
[".local/share/blesh"]
type = "archive"
url = "https://github.com/akinomyoga/ble.sh/releases/download/{{ .ble.tag }}/ble-{{ .ble.tag }}.tar.xz"
checksum.sha256 = "{{ .ble.sha256 }}"
exact = true
stripComponents = 1
{{- end }}
