{{- $token := "" -}}
{{- if and (hasKey . "secrets") (hasKey .secrets "aqua_github_token") -}}
  {{- $ref := .secrets.aqua_github_token -}}
  {{- /* Any non-empty NREDF_NO_BOOTSTRAP skips the vault, same as the hooks. */ -}}
  {{- if and $ref (not (env "CI")) (eq (env "NREDF_NO_BOOTSTRAP") "") -}}
    {{- if or (hasPrefix "bitwarden:" $ref) (hasPrefix "bw:" $ref) -}}
      {{- if lookPath "bw" -}}
        {{- $itemName := $ref | trimPrefix "bitwarden:" | trimPrefix "bw:" -}}
        {{- $item := bitwarden "item" $itemName -}}
        {{- /* `bw get item` emits explicit nulls ("notes": null, "login": null, a
               field "value": null). hasKey is true for those and the nil then
               reaches `trim` below and aborts the whole apply, so read every
               value through `index | default` instead. */ -}}
        {{- $login := index $item "login" | default (dict) -}}
        {{- $token = index $login "password" | default "" -}}
        {{- if eq $token "" -}}
          {{- range (index $item "fields" | default (list)) -}}
            {{- $name := index . "name" | default "" -}}
            {{- $value := index . "value" | default "" -}}
            {{- if and (or (eq $name "token") (eq $name "aqua_github_token") (eq $name "password")) (ne $value "") -}}
              {{- $token = $value -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
        {{- /* Also when fields exist but none of them holds a token. */ -}}
        {{- if eq $token "" -}}
          {{- $token = index $item "notes" | default "" -}}
        {{- end -}}
      {{- end -}}
    {{- else if hasPrefix "keepassxc:" $ref -}}
      {{- if lookPath "keepassxc-cli" -}}
        {{- $entry := trimPrefix "keepassxc:" $ref -}}
        {{- $item := keepassxc $entry -}}
        {{- $token = index $item "Password" | default (index $item "Notes") | default "" -}}
      {{- end -}}
    {{- else if or (hasPrefix "onepassword:" $ref) (hasPrefix "op:" $ref) -}}
      {{- if lookPath "op" -}}
        {{- $itemName := $ref | trimPrefix "onepassword:" | trimPrefix "op:" -}}
        {{- /* chezmoi's signature is `onepassword <item> [vault [account]]`, so the
               item name goes first. `op item get` JSON has no top-level password
               or notes: both are fields (notes: id "notesPlain", purpose "NOTES"),
               and a field left empty has no "value" key at all. */ -}}
        {{- $item := onepassword $itemName -}}
        {{- $notes := "" -}}
        {{- range (index $item "fields" | default (list)) -}}
          {{- $id := index . "id" | default "" -}}
          {{- $label := index . "label" | default "" -}}
          {{- $value := index . "value" | default "" -}}
          {{- if ne $value "" -}}
            {{- if or (eq $id "password") (eq $id "token") (eq $label "password") (eq $label "token") -}}
              {{- $token = $value -}}
            {{- else if or (eq $id "notesPlain") (eq (index . "purpose" | default "") "NOTES") -}}
              {{- $notes = $value -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if eq $token "" -}}
          {{- $token = $notes -}}
        {{- end -}}
      {{- end -}}
    {{- else -}}
      {{- $token = $ref -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $token | trim -}}
