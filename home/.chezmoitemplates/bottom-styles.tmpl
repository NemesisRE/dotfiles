# OneDark-Pro theme for bottom (btm) matching Kitty, Zellij, and Neovim
[styles.widgets]
border_colour = "#3F4451"
selected_border_colour = "#61AFEF"
widget_title = { colour = "#ABB2BF", bold = true }
text = { colour = "#ABB2BF" }
selected_text = { colour = "#282C34", bg_colour = "#61AFEF" }
disabled_text = { colour = "#4F5666" }

[styles.tables]
headers = { colour = "#61AFEF", bold = true }

[styles.graphs]
graph_colour = "#4F5666"
legend_text = { colour = "#ABB2BF" }

[styles.cpu]
all_entry_colour = "#98C379"
avg_entry_colour = "#E06C75"
cpu_core_colours = [
  "#61AFEF",
  "#98C379",
  "#E5C07B",
  "#E06C75",
  "#C678DD",
  "#56B6C2",
  "#D19A66",
  "#4CD1E0",
]

[styles.memory]
ram_colour = "#C678DD"
cache_colour = "#E06C75"
swap_colour = "#E5C07B"
arc_colour = "#56B6C2"
gpu_colours = ["#61AFEF", "#98C379", "#56B6C2", "#D19A66"]

[styles.network]
rx_colour = "#98C379"
tx_colour = "#61AFEF"
rx_total_colour = "#56B6C2"
tx_total_colour = "#E5C07B"

[styles.battery]
high_battery_colour = "#98C379"
medium_battery_colour = "#E5C07B"
low_battery_colour = "#E06C75"
