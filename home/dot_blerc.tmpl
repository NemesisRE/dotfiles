# -*- mode: sh; mode: sh-bash -*-
# Managed by chezmoi — NREDF ble.sh (Bash Line Editor) configuration
# https://github.com/akinomyoga/ble.sh

# ── 1. Core & Performance Options ─────────────────────────────────────────────
# Responsive autosuggestions (matches zsh-autosuggestions latency)
bleopt complete_auto_delay=100

# Limit completion menu height in small viewports
bleopt complete_menu_maxlines=10

# Silence terminal bell / beeps
bleopt bell_style=none

# ── 2. Prompt & Layout ────────────────────────────────────────────────────────
# Required for multi-line prompts & Oh-My-Posh layout sync
bleopt prompt_command_changes_layout=1

# Disable the red [ble: exit N] error marker to keep prompt clean
bleopt exec_errexit_mark=

# ── 3. Fzf & Carapace Completion Integration ──────────────────────────────────
# Base directory for fzf shell scripts (managed via .chezmoiexternal in .config/fzf)
_ble_contrib_fzf_base="${XDG_CONFIG_HOME:-$HOME/.config}/fzf"

if command -v fzf &>/dev/null; then
  ble-import -d integration/fzf-completion
  ble-import -d integration/fzf-key-bindings
  ble-import -d integration/fzf-menu -C '
    bleopt integration_fzf_menu_enabled=0
    ble-bind -c "C-@" "bleopt integration_fzf_menu_enabled=1; ble/widget/menu-complete; bleopt integration_fzf_menu_enabled=0"
  '
fi

# ── 4. OneDark-Pro Theme & UI Faces ───────────────────────────────────────────
# Match AstroNvim, bat, and oh-my-posh OneDark-Pro palette
ble-face -s auto_complete 'fg=242'
ble-face -s command_function ref:command_alias
ble-face -s syntax_command 'fg=75'
ble-face -s syntax_quoted 'fg=114'
ble-face -s syntax_error 'fg=204,underline'
ble-face -s syntax_comment 'fg=242'

# ── 5. Keymaps & Platform Hooks ───────────────────────────────────────────────
function blerc/vim-load-hook {
  ((_ble_bash >= 40300)) && builtin bind 'set keyseq-timeout 1'
}
blehook/eval-after-load keymap_vi blerc/vim-load-hook

{{- if eq .chezmoi.os "darwin" }}
if declare -f ble-bind >/dev/null 2>&1; then
  ble-bind -m emacs   -c 'ç' 'eval "$(__fzf_cd__)"' 2>/dev/null || true
  ble-bind -m vi_imap -c 'ç' 'eval "$(__fzf_cd__)"' 2>/dev/null || true
  ble-bind -m vi_nmap -c 'ç' 'eval "$(__fzf_cd__)"' 2>/dev/null || true
  ble-bind -m emacs   -c '©' 'eval "$(__fzf_cd__)"' 2>/dev/null || true
  ble-bind -m vi_imap -c '©' 'eval "$(__fzf_cd__)"' 2>/dev/null || true
  ble-bind -m vi_nmap -c '©' 'eval "$(__fzf_cd__)"' 2>/dev/null || true
fi
{{- end }}
