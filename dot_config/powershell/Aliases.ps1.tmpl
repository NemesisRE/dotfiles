# Kubernetes aliases
Set-Alias k -Value kubectl -ErrorAction SilentlyContinue
Set-Alias kns -Value Select-KubeNamespace -ErrorAction SilentlyContinue
Set-Alias kctx -Value Select-KubeContext -ErrorAction SilentlyContinue

# Un-shadow default PowerShell cmdlets so real CLI tools are called
foreach ($a in @('ls', 'cat', 'curl', 'wget', 'r')) {
    if (Test-Path "Alias:$a") {
        Remove-Item "Alias:$a" -Force -ErrorAction SilentlyContinue
    }
}

# Modern CLI tool aliases
if (Get-Command lsd -ErrorAction SilentlyContinue) {
    Set-Alias ls -Value lsd -Option AllScope
    function ll { lsd -l @args }
    function la { lsd -la @args }
    function lt { lsd --tree @args }
}

if (Get-Command bat -ErrorAction SilentlyContinue) {
    Set-Alias cat -Value bat -Option AllScope
}

if (Get-Command lazygit -ErrorAction SilentlyContinue) {
    Set-Alias lg -Value lazygit -Option AllScope
}

if (Get-Command helix -ErrorAction SilentlyContinue) {
    Set-Alias hx -Value helix -Option AllScope
}

if (Get-Command rg -ErrorAction SilentlyContinue) {
    Set-Alias grep -Value rg -Option AllScope
} elseif (Get-Command ripgrep -ErrorAction SilentlyContinue) {
    Set-Alias grep -Value ripgrep -Option AllScope
}

if (Get-Command dust -ErrorAction SilentlyContinue) {
    Set-Alias du -Value dust -Option AllScope
}

if (Get-Command duf -ErrorAction SilentlyContinue) {
    Set-Alias df -Value duf -Option AllScope
}
