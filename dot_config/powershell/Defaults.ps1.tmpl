${MODULES} = New-Object System.Collections.ArrayList

$isWin = if (Test-Path variable:IsWindows) { $IsWindows } else { [System.Environment]::OSVersion.Platform -eq [System.PlatformID]::Win32NT }
$isLin = if (Test-Path variable:IsLinux) { $IsLinux } else { $false }
$isMac = if (Test-Path variable:IsMacOS) { $IsMacOS } else { $false }

if ($isWin) {
    if (-not $env:XDG_CONFIG_HOME) { $env:XDG_CONFIG_HOME = "$HOME\.config" }
    if (-not $env:XDG_DATA_HOME) { $env:XDG_DATA_HOME = "$HOME\.local\share" }
    if (-not $env:XDG_CACHE_HOME) { $env:XDG_CACHE_HOME = "$HOME\.cache" }

    $localBin = "$HOME\.local\bin"
    $aquaBinLocal = "$HOME\.local\share\aquaproj-aqua\bin"
    $aquaBinAppData = if ($env:LOCALAPPDATA) { "$env:LOCALAPPDATA\aquaproj-aqua\bin" } else { "" }

    foreach ($p in @($localBin, $aquaBinLocal, $aquaBinAppData)) {
        if ($p -and (Test-Path $p) -and ($env:PATH -notlike "*$p*")) {
            $env:PATH = "$p;$env:PATH"
        }
    }

    $env:NREDF_LRCACHE = "$env:LOCALAPPDATA\nredf\LRCache"
    [Void]${MODULES}.Add("GuiCompletion")
} else {
    $xdgBinHome = if ($env:XDG_BIN_HOME) { $env:XDG_BIN_HOME } else { "$HOME/.local/bin" }
    $aquaBin = if ($env:AQUA_ROOT_DIR) { "$env:AQUA_ROOT_DIR/bin" } else { "$HOME/.local/share/aquaproj-aqua/bin" }

    foreach ($p in @($xdgBinHome, $aquaBin)) {
        if ($p -and (Test-Path $p) -and ($env:PATH -notlike "*$p*")) {
            $env:PATH = "$p:$env:PATH"
        }
    }

    $env:POSH_THEMES_PATH = "$env:XDG_CACHE_HOME/oh-my-posh/themes"
    $env:NREDF_LRCACHE = "$env:XDG_CACHE_HOME/nredf/LRCache"
}
