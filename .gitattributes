# Normalize line endings — LF everywhere (unix dotfiles repo)
*                         text=auto eol=lf

# Diff drivers for richer `git diff` output
*.bash                    diff=bash
*.sh                      diff=bash
*.bash.tmpl               diff=bash
*.sh.tmpl                 diff=bash
*.zsh.tmpl                diff=bash
*.md                      diff=markdown
*.md.tmpl                 diff=markdown
*bashrc*                  diff=bash
*bash_profile*            diff=bash
*bash_login*              diff=bash
*bash_logout*             diff=bash
*bash_aliases*            diff=bash
*zshrc*                   diff=bash
*zprofile*                diff=bash
*zshenv*                  diff=bash
*zlogin*                  diff=bash
*zlogout*                 diff=bash
*blerc*                   diff=bash
rc.tmpl                   diff=bash
functions.bundle.tmpl     diff=bash
aliases                   diff=bash
bindings                  diff=bash
functions                 diff=bash
functions.bundle          diff=bash

# GitHub Linguist — Template files (*.tmpl)
*.toml.tmpl               linguist-language=TOML
*.yaml.tmpl               linguist-language=YAML
*.yml.tmpl                linguist-language=YAML
*.json.tmpl               linguist-language=JSON
*.ps1.tmpl                linguist-language=PowerShell
*.lua.tmpl                linguist-language=Lua
*.kdl.tmpl                linguist-language=KDL
*.md.tmpl                 linguist-language=Markdown
*.sh.tmpl                 linguist-language=Shell
*.bash.tmpl               linguist-language=Shell
*.zsh.tmpl                linguist-language=Shell
*.conf.tmpl               linguist-language=INI
*.ini.tmpl                linguist-language=INI

# GitHub Linguist — Standard shell scripts & dotfiles (extensionless & templates)
*bashrc*                  linguist-language=Shell
*bash_profile*            linguist-language=Shell
*bash_login*              linguist-language=Shell
*bash_logout*             linguist-language=Shell
*bash_aliases*            linguist-language=Shell
*zshrc*                   linguist-language=Shell
*zprofile*                linguist-language=Shell
*zshenv*                  linguist-language=Shell
*zlogin*                  linguist-language=Shell
*zlogout*                 linguist-language=Shell
*blerc*                   linguist-language=Shell
rc.tmpl                   linguist-language=Shell
functions.bundle.tmpl     linguist-language=Shell
aliases                   linguist-language=Shell
bindings                  linguist-language=Shell
functions                 linguist-language=Shell
functions.bundle          linguist-language=Shell

# GitHub Linguist — Known config formats
*gitconfig*               linguist-language=Git-Config
*.gitconfig.tmpl          linguist-language=Git-Config
**/dot_config/git/config* linguist-language=Git-Config
*editorconfig*            linguist-language=EditorConfig
*chezmoiignore*           linguist-language=Ignore-List
*gitkeep*                 linguist-language=Ignore-List
**/dot_local/share/konsole/* linguist-language=INI

# Exclude dev/CI tooling from `git archive` tarballs
.editorconfig             export-ignore
.shellcheckrc             export-ignore
.yamllint.yml             export-ignore
.github/                  export-ignore
.vscode/                  export-ignore
